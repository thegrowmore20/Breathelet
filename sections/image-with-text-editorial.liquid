{% liquid
  if section.settings.image_position == 'right'
    assign img_right = true
  else
    assign img_right = false
  endif
%}

<style>
  #shopify-section-{{ section.id }} .editorial__text {
    {% render 'apply-color-var', var: '--color-background', color: section.settings.background_color %}
    {% render 'apply-color-var', var: '--color-foreground', color: section.settings.text_color %}
    {% render 'apply-color-var', var: '--color-headings',   color: section.settings.heading_color %}
    min-height: {{ section.settings.min_height_mobile }}px;
  }

  #shopify-section-{{ section.id }} .editorial__image {
    {% render 'apply-color-var', var: '--color-background', color: section.settings.background_color %}
    background: var(--color-background);
  }

  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .editorial__text,
    #shopify-section-{{ section.id }} .editorial__image {
      min-height: {{ section.settings.min_height_desktop }}px;
    }
  }
</style>

{% render 'section-bg-number-vars', full_width: section.settings.full_width %}
<div
  class="editorial-section overflow-hidden
    {% if section.settings.full_width %}section section--full-width{% else %}section section--block{% endif %}
  "
  style="{% render 'section-style' %}; {% if section.settings.remove_bottom_spacing %}padding-bottom: 0 !important;{% endif %}"
>
  <div class="
    grid
    {% if img_right %}
      lg:grid-cols-image-with-text--image-right
    {% else %}
      lg:grid-cols-image-with-text
    {% endif %}
  ">

    {%- comment -%} ── TEXT COLUMN ──────────────────────────────── {%- endcomment -%}
    <div class="
      editorial__text color
      flex flex-col justify-center
      {% if img_right %}order-2 lg:order-1{% else %}order-2 lg:order-2{% endif %}
      rfs:py-20
      px-[--container-padding]
      {% if img_right %}lg:pl-[--container-padding] lg:pr-16{% else %}lg:pr-[--container-padding] lg:pl-16{% endif %}
    ">
      <div class="trim-margins w-full max-w-xl {% if img_right %}lg:ml-auto{% endif %}">

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'eyebrow' -%}
              <p
                class="text-xs md:text-sm tracking-[0.2em] uppercase mb-6 opacity-75 leading-none"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.number != blank -%}
                  {{- block.settings.number -}}
                  <span class="mx-2 opacity-60">/</span>
                {%- endif -%}
                {{- block.settings.label -}}
              </p>

            {%- when 'heading' -%}
              {%- assign htag = block.settings.heading_html_tag | default: 'h2' -%}
              <{{ htag }}
                class="{{ block.settings.heading_size | default: 'h0' }} mt-0 mb-6"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.heading | escape -}}
              </{{ htag }}>

            {%- when 'text' -%}
              <div
                class="prose text-current max-w-none mb-8 opacity-90 text-sm md:text-base"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </div>

            {%- when 'link' -%}
              <div class="mt-8" {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  class="
                    inline-flex items-center gap-3
                    text-xs md:text-sm tracking-[0.18em] uppercase
                    border-b border-current pb-px
                    opacity-90 hover:opacity-60 transition-opacity duration-200
                  "
                >
                  {{- block.settings.text -}}
                  {%- if block.settings.show_arrow -%}
                    <span aria-hidden="true" class="text-sm">→</span>
                  {%- endif -%}
                </a>
              </div>

          {%- endcase -%}
        {%- endfor -%}

      </div>
    </div>

    {%- comment -%} ── IMAGE COLUMN ─────────────────────────────── {%- endcomment -%}
    {%- assign img_inset = section.settings.image_inset | default: 24 -%}
    <div class="
      editorial__image relative overflow-hidden
      {% if section.settings.image_size != blank %}
        media {{ section.settings.image_size }}
      {% else %}
        min-h-[300px] md:min-h-[480px]
      {% endif %}
      {% if img_right %}order-1 lg:order-2{% else %}order-1 lg:order-1{% endif %}
    ">
      {%- if section.settings.image -%}
        <div
          class="absolute overflow-hidden"
          style="inset: {{ img_inset }}px;"
        >
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'absolute inset-0 block w-full h-full object-cover',
              sizes: '(min-width: 1024px) 50vw, 100vw',
              loading: 'lazy'
          }}
        </div>
      {%- else -%}
        <div
          class="absolute flex items-center justify-center bg-neutral-200"
          style="inset: {{ img_inset }}px;"
        >
          {%- render 'placeholder', type: 'image' -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Editorial: Image + Text",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "remove_bottom_spacing",
      "label": "Remove bottom spacing",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "media--ratio-4-3",  "label": "Landscape (4:3)"   },
        { "value": "media--ratio-16-9", "label": "Wide (16:9)"        },
        { "value": "media--ratio-3-4",  "label": "Portrait (3:4)"     },
        { "value": "media--ratio-2-3",  "label": "Tall (2:3)"         },
        { "value": "media--ratio-1-1",  "label": "Square (1:1)"       },
        { "value": "",                  "label": "Original (fill)"    }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "image_inset",
      "label": "Image padding (px)",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left",  "label": "Left"  }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Section height"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Min height – desktop (px)",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 560
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Min height – mobile (px)",
      "min": 200,
      "max": 600,
      "step": 20,
      "default": 300
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / prefix",
          "default": "01",
          "info": "e.g. 01  — leave blank to hide"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label text",
          "default": "THE SYMBOL"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading text",
          "default": "BREATHE"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Size",
          "options": [
            { "value": "h0", "label": "Display (H0)" },
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h0"
        },
        {
          "type": "select",
          "id": "heading_html_tag",
          "label": "HTML tag",
          "options": [
            { "value": "h1", "label": "h1" },
            { "value": "h2", "label": "h2" },
            { "value": "h3", "label": "h3" },
            { "value": "p",  "label": "p"  }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Body text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>This archaic Sanskrit symbol gracefully inspires us to embrace our natural responses. It represents life's first and final acts, portraying the elegant symmetry of our existence.</p>"
        }
      ]
    },
    {
      "type": "link",
      "name": "Text link",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Link text",
          "default": "DISCOVER THE MEANING"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "show_arrow",
          "label": "Show arrow (→)",
          "default": true
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "presets": [
    {
      "name": "Editorial: Image + Text",
      "blocks": [
        { "type": "heading" },
        { "type": "text"    },
        {
          "type": "link",
          "settings": {
            "text": "Shop Breathelet",
            "show_arrow": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
