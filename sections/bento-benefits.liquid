{% render 'section-bg-number-vars' %}

{%- capture bento_style -%}
  --bento-primary: {{ section.settings.primary_color }};
  --bento-primary-rgb: {{ section.settings.primary_color.rgb }};
  --bento-secondary: {{ section.settings.secondary_color }};
  --bento-secondary-rgb: {{ section.settings.secondary_color.rgb }};
  --bento-card: {{ section.settings.card_background }};
  --bento-card-rgb: {{ section.settings.card_background.rgb }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'bento-section', style: bento_style %}>
  <div class="section-body">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div
        class="section-header section-content-spacing rfs:mb-12 prose-align text-left"
        data-animation="block"
        data-animation-group="{{ section.id }}-head"
      >
        {%- if section.settings.eyebrow != blank -%}
          <div class="subheading eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="heading {{ section.settings.heading_size | default: 'h0' }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bento grid gap-5">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_class = 'tile ' | append: block.settings.width
          case block.settings.style
            when 'spotlight'
              assign tile_class = tile_class | append: ' tile--spotlight dark'
            when 'dark'
              assign tile_class = tile_class | append: ' dark'
            else
              assign tile_class = tile_class | append: ' color'
          endcase
        -%}
        <div
          class="{{ tile_class }} rounded-block p-6 md:p-8"
          data-animation="block"
          data-animation-group="{{ section.id }}-tiles"
          {{ block.shopify_attributes }}
        >
          {%- case block.settings.marker -%}
            {%- when 'number' -%}
              <div class="num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
            {%- when 'big_text' -%}
              {%- if block.settings.big_text != blank -%}
                <div class="big">{{ block.settings.big_text | escape }}</div>
              {%- endif -%}
            {%- when 'icon' -%}
              <div class="ic">
                {%- case block.settings.icon -%}
                  {%- when 'plus' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14"/></svg>
                  {%- when 'lines' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                  {%- when 'drop' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12a8 8 0 1 1-16 0c0-5 8-10 8-10s8 5 8 10z"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 13l4 4L19 7"/></svg>
                  {%- when 'heart' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
                {%- endcase -%}
              </div>
          {%- endcase -%}
          <div>
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .bento-section {
    --bento-body-muted: rgb(var(--bento-primary-rgb) / 70%);
    --bento-card-border: rgb(var(--bento-primary-rgb) / 12%);
    --bento-dark-border: rgb(var(--bento-secondary-rgb) / 42%);
    --bento-ease: cubic-bezier(0.2, 0, 0, 1);
  }

  .bento-section .section-header .eyebrow {
    color: var(--bento-secondary);
  }

  .bento-section .section-header .heading {
    max-width: 760px;
    margin-top: 16px;
  }

  .bento-section .section-header .heading em {
    color: var(--bento-secondary);
    font-style: italic;
  }

  .bento-section h3 {
    font-family: var(--font-heading-family, Georgia, serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .bento-section .bento {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .bento-section .tile {
    position: relative;
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .bento-section .tile.color {
    border: 1px solid var(--bento-card-border);
    background-color: var(--bento-card);
    color: var(--bento-primary);
  }

  .bento-section .tile--spotlight {
    border: 1px solid var(--bento-dark-border);
    background: radial-gradient(circle at 92% 12%, rgb(var(--bento-secondary-rgb) / 18%), transparent 30%), var(--bento-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .bento-section .tile {
      transition: transform 240ms var(--bento-ease);
    }

    .bento-section .tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 1rem 2.5rem rgb(var(--bento-primary-rgb) / 18%);
    }

    .bento-section .tile--spotlight:hover {
      border-color: var(--bento-secondary);
    }
  }

  .bento-section .tile.s2 {
    grid-column: span 2;
  }

  .bento-section .tile.s4 {
    grid-column: span 4;
  }

  .bento-section .tile.dark {
    background-color: var(--bento-primary);
    color: var(--bento-card);
  }

  .bento-section .tile .num {
    color: var(--bento-secondary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .bento-section .tile h3 {
    margin-top: auto;
    font-size: clamp(1.75rem, 2.7vw, 2.5rem);
  }

  .bento-section .tile p {
    max-width: 360px;
    margin-top: 12px;
    color: var(--bento-body-muted);
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .bento-section .tile.dark p {
    color: rgb(var(--bento-card-rgb) / 72%);
  }

  .bento-section .tile .big {
    font-family: var(--font-heading-family, Georgia, serif);
    color: var(--bento-secondary);
    font-size: clamp(5rem, 8vw, 7rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .bento-section .ic {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid rgb(var(--bento-secondary-rgb) / 45%);
    border-radius: 50%;
    color: var(--bento-secondary);
  }

  .bento-section .ic svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  @media (max-width: 991px) {
    .bento-section .bento {
      grid-template-columns: 1fr 1fr;
    }

    .bento-section .tile.s2,
    .bento-section .tile.s4 {
      grid-column: span 2;
    }
  }

  @media (max-width: 575px) {
    .bento-section .tile,
    .bento-section .tile--spotlight {
      min-height: 15rem;
    }

    .bento-section .bento {
      grid-template-columns: 1fr;
    }

    .bento-section .tile.s2,
    .bento-section .tile.s4 {
      grid-column: span 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-section .tile {
      transition: none;
    }

    .bento-section .tile:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bento benefits",
  "class": "section-bento",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why people love it" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> for the accent colour.", "default": "Calm that <em>fits your day.</em>" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "3X-Large" },
        { "value": "h1", "label": "2X-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" }
      ],
      "default": "h0"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "primary_color", "label": "Primary (dark tiles, light tile text)", "default": "#000000" },
    { "type": "color", "id": "secondary_color", "label": "Secondary (accent)", "default": "#A57C72" },
    { "type": "color", "id": "card_background", "label": "Light tile background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "spotlight", "label": "Spotlight (dark with glow)" },
            { "value": "dark", "label": "Dark" },
            { "value": "light", "label": "Light" }
          ],
          "default": "light"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            { "value": "s2", "label": "Narrow (2 of 6 columns)" },
            { "value": "s4", "label": "Wide (4 of 6 columns)" }
          ],
          "default": "s2"
        },
        {
          "type": "select",
          "id": "marker",
          "label": "Top marker",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "number", "label": "Number" },
            { "value": "icon", "label": "Icon" },
            { "value": "big_text", "label": "Big text" }
          ],
          "default": "icon"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "plus", "label": "Plus" },
            { "value": "lines", "label": "Lines" },
            { "value": "drop", "label": "Drop" },
            { "value": "check", "label": "Check" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "plus"
        },
        { "type": "text", "id": "big_text", "label": "Big text", "default": "0" },
        { "type": "text", "id": "title", "label": "Title", "default": "Reset anywhere" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Desk, commute, kitchen. Wherever you are, anytime." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento benefits",
      "blocks": [
        { "type": "tile", "settings": { "style": "spotlight", "width": "s4", "marker": "number", "title": "Feel present again", "text": "A vibration only you can feel. You check your phone 150 times a day — Breathelet reminds you to check yourself." } },
        { "type": "tile", "settings": { "style": "light", "width": "s2", "marker": "icon", "icon": "plus", "title": "Reset anywhere", "text": "Desk, commute, kitchen. Wherever you are, anytime." } },
        { "type": "tile", "settings": { "style": "light", "width": "s2", "marker": "icon", "icon": "lines", "title": "Mindful habits", "text": "Posture, hydration, breath — small cues, lasting routines." } },
        { "type": "tile", "settings": { "style": "light", "width": "s2", "marker": "big_text", "big_text": "0", "title": "Screens. Apps.", "text": "No setup, no notifications. Just wear it." } },
        { "type": "tile", "settings": { "style": "light", "width": "s2", "marker": "icon", "icon": "drop", "title": "A meaningful gift", "text": "Give someone a daily reminder that you care." } }
      ]
    }
  ]
}
{% endschema %}
