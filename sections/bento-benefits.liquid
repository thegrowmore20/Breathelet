{% render 'section-bg-number-vars' %}

<section class="section section--full-width" {{ section.shopify_attributes }}>
  <div class="section-body">
    <div class="section-header section-content-spacing rfs:mb-12 prose-align text-left">
      <div class="rv">
        <div class="subheading eyebrow">Why people love it</div>
        <h2 class="heading {{ section.settings.heading_size | default: 'h0' }}">Calm that <em>fits your day.</em></h2>
      </div>
    </div>
    <div class="bento grid gap-5">
      <div class="tile tile--spotlight s4 dark rounded-block p-6 md:p-8 rv">
        <div class="num">01</div>
        <div><h3>Feel present again</h3><p>A vibration only you can feel. You check your phone 150 times a day â€” Breathelet reminds you to check yourself.</p></div>
      </div>
      <div class="tile s2 color rounded-block p-6 md:p-8 rv d1">
        <div class="ic"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5v14"/></svg></div>
        <div><h3>Reset anywhere</h3><p>Desk, commute, kitchen. Wherever you are, anytime.</p></div>
      </div>
      <div class="tile s2 color rounded-block p-6 md:p-8 rv">
        <div class="ic"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg></div>
        <div><h3>Mindful habits</h3><p>Posture, hydration, breath â€” small cues, lasting routines.</p></div>
      </div>
      <div class="tile s2 color rounded-block p-6 md:p-8 rv d1">
        <div class="big">0</div>
        <div><h3>Screens. Apps.</h3><p>No setup, no notifications. Just wear it.</p></div>
      </div>
      <div class="tile s2 color rounded-block p-6 md:p-8 rv d2">
        <div class="ic"><svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-16 0c0-5 8-10 8-10s8 5 8 10z"/></svg></div>
        <div><h3>A meaningful gift</h3><p>Give someone a daily reminder that you care.</p></div>
      </div>
    </div>
  </div>
</section>

{% javascript %}
  (() => {
    const items = document.querySelectorAll('.section-bento .rv');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion || !('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('in'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    items.forEach((item) => observer.observe(item));
  })();
{% endjavascript %}

{% stylesheet %}
  .section-bento {
    --bento-primary: #0b0b0b;
    --bento-secondary: #a57c72;
    --bento-body-muted: #5c5551;
    --bento-card-border: rgba(11, 11, 11, 0.12);
    --bento-dark-border: rgba(165, 124, 114, 0.42);
    --bento-ease: cubic-bezier(0.2, 0, 0, 1);
    background: transparent;
    color: #ffffff;
  }

  .section-bento .section-body {
    background: transparent;
  }

  .section-bento .section-header {
    color: #ffffff;
  }

  .section-bento .section-header .eyebrow {
    color: var(--bento-secondary);
  }

  .section-bento .section-header .heading {
    max-width: 760px;
    margin-top: 16px;
    color: #ffffff;
  }

  .section-bento .section-header .heading em {
    color: var(--bento-secondary);
    font-style: italic;
  }

  .section-bento h3 {
    font-family: var(--font-heading-family, Georgia, serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .section-bento .bento {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .section-bento .tile {
    position: relative;
    display: flex;
    min-height: 19rem;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    transition: transform 240ms var(--bento-ease), box-shadow 240ms var(--bento-ease), border-color 240ms var(--bento-ease);
  }

  .section-bento .tile.color {
    --color-background: 255 255 255;
    --color-foreground: 11 11 11;
    border: 1px solid var(--bento-card-border);
    color: var(--bento-primary);
  }

  .section-bento .tile--spotlight {
    min-height: 19rem;
    border: 1px solid var(--bento-dark-border);
    background: radial-gradient(circle at 92% 12%, rgba(165, 124, 114, 0.18), transparent 30%), var(--bento-primary);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  @media (hover: hover) and (pointer: fine) {
    .section-bento .tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.18);
    }

    .section-bento .tile--spotlight:hover {
      border-color: var(--bento-secondary);
      box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }
  }

  .section-bento .tile.s2 {
    grid-column: span 2;
  }

  .section-bento .tile.s4 {
    grid-column: span 4;
  }

  .section-bento .tile.dark {
    background-color: var(--bento-primary);
    color: #ffffff;
  }

  .section-bento .tile .num {
    color: var(--bento-secondary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .section-bento .tile h3 {
    margin-top: auto;
    font-size: clamp(1.75rem, 2.7vw, 2.5rem);
  }

  .section-bento .tile p {
    max-width: 360px;
    margin-top: 12px;
    color: var(--bento-body-muted);
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .section-bento .tile.dark p {
    color: rgba(255, 255, 255, 0.72);
  }

  .section-bento .tile .big {
    font-family: var(--font-heading-family, Georgia, serif);
    color: var(--bento-secondary);
    font-size: clamp(5rem, 8vw, 7rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
  }

  .section-bento .ic {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border: 1px solid rgba(165, 124, 114, 0.45);
    border-radius: 50%;
    color: var(--bento-secondary);
  }

  .section-bento .ic svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .section-bento .rv {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 300ms var(--bento-ease), transform 300ms var(--bento-ease);
  }

  .section-bento .rv.in {
    opacity: 1;
    transform: none;
  }

  .section-bento .d1 {
    transition-delay: 0.1s;
  }

  .section-bento .d2 {
    transition-delay: 0.2s;
  }

  @media (max-width: 991px) {
    .section-bento .bento {
      grid-template-columns: 1fr 1fr;
    }

    .section-bento .tile.s2,
    .section-bento .tile.s4 {
      grid-column: span 2;
    }
  }

  @media (max-width: 575px) {
    .section-bento .tile,
    .section-bento .tile--spotlight {
      min-height: 15rem;
    }

    .section-bento .bento {
      grid-template-columns: 1fr;
    }

    .section-bento .tile.s2,
    .section-bento .tile.s4 {
      grid-column: span 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-bento .tile,
    .section-bento .rv {
      transition: none;
    }

    .section-bento .rv {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bento benefits",
  "class": "section-bento",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "3X-Large" },
        { "value": "h1", "label": "2X-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" }
      ],
      "default": "h0"
    }
  ],
  "presets": [
    {
      "name": "Bento benefits"
    }
  ]
}
{% endschema %}
