{% render 'section-bg-number-vars' %}

{%- capture accent_style -%}
  --primary: {{ section.settings.primary_color }};
  --accent: {{ section.settings.accent_color }};
  --accent-rgb: {{ section.settings.accent_color.rgb }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'cm', style: accent_style %}>
  <div class="section-body">
    <div class="cm-row flex">
      {%- for block in section.blocks -%}
        <article
          class="cm-card relative flex-1 overflow-hidden"
          data-animation="block"
          data-animation-group="{{ section.id }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- assign cm_alt = block.settings.image.alt | default: block.settings.heading | default: 'Breathelet community' -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                class: 'absolute inset-0 w-full h-full',
                widths: '352, 550, 832, 1200, 1500',
                sizes: '(min-width: 768px) 50vw, 100vw',
                loading: 'lazy',
                decoding: 'async',
                alt: cm_alt
            }}
          {%- endif -%}
          <div class="cm-shade absolute inset-0"></div>
          <div class="cm-tx absolute">
            {%- if block.settings.eyebrow != blank -%}
              <div class="subheading">{{ block.settings.eyebrow | escape }}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="m-0 {{ section.settings.heading_size | default: 'h2' }}">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a
                class="btn inline-flex items-center justify-center rounded-full whitespace-nowrap {% if block.settings.button_style == 'white' %}btn-w{% else %}btn-ac{% endif %}"
                href="{{ block.settings.button_link }}"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cm {
    --cm-line: rgb(var(--color-foreground) / 10%);
    --cm-ac: var(--accent);
    content-visibility: auto;
    contain-intrinsic-size: auto 560px;
  }

  .cm-row {
    gap: clamp(14px, 1.5vw, 20px);
    height: min(640px, 76svh);
    min-height: 460px;
  }

  .cm-card {
    min-width: 0;
    border-radius: 24px;
    isolation: isolate;
    border: 1px solid var(--cm-line);
    box-shadow: inset 0 1px 0 rgb(var(--color-foreground) / 6%);
  }

  .cm-card img {
    object-fit: cover;
    z-index: -2;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cm-shade {
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgb(var(--cm-shade-rgb, 0 0 0) / 96%) 0%,
      rgb(var(--cm-shade-rgb, 0 0 0) / 74%) 44%,
      rgb(var(--cm-shade-rgb, 0 0 0) / 10%) 76%
    );
  }

  .cm .btn:focus-visible {
    outline: 2px solid var(--cm-ac);
    outline-offset: 3px;
  }

  .cm-tx {
    left: clamp(24px, 3.4vw, 48px);
    right: clamp(24px, 3.4vw, 48px);
    bottom: clamp(26px, 4.4vh, 48px);
  }

  .cm-tx .subheading {
    color: var(--cm-ac);
    margin-bottom: 10px;
  }

  .cm-tx h3 {
    max-width: 520px;
    color: rgb(var(--color-foreground));
  }

  .cm-tx p {
    color: rgb(var(--color-foreground) / 84%);
    font-size: 15px;
    line-height: 1.65;
    max-width: 440px;
    margin: 14px 0 24px;
  }

  .cm .btn {
    height: 48px;
    padding: 0 28px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cm .btn-ac {
    background: var(--cm-ac);
    color: var(--primary);
  }

  .cm .btn-w {
    background: rgb(var(--color-foreground));
    color: var(--primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .cm-card:hover {
      border-color: rgb(var(--accent-rgb) / 55%);
    }

    .cm-card:hover img {
      transform: scale(1.05);
    }

    .cm .btn:hover {
      transform: translateY(-2px);
    }

    .cm .btn-ac:hover {
      background: rgb(var(--accent-rgb) / 88%);
    }

    .cm .btn-w:hover {
      background: var(--cm-ac);
    }
  }

  @media (max-width: 767px) {
    .cm-row {
      flex-direction: column;
      height: auto;
    }

    .cm-card {
      flex: none;
      height: min(500px, 68svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm-card img,
    .cm .btn {
      transition: none;
    }

    .cm-card:hover img,
    .cm .btn:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Community cards",
  "class": "section-community-cards",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "Card heading size",
      "options": [
        { "value": "h0", "label": "3X-Large" },
        { "value": "h1", "label": "2X-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" }
      ],
      "default": "h2"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F0EE" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Secondary (accent)", "default": "#A57C72" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Influencer Community" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Share mindful living, everyday calm, and meaningful wellness with your audience through authentic content." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Become an Influencer" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "white", "label": "White" }
          ],
          "default": "accent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community cards",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "heading": "Partner With Breathelet",
            "text": "Bring mindful wellness to your customers with wholesale pricing designed for retailers, distributors, and gift programs.",
            "button_label": "Get Wholesale Quote",
            "button_style": "white"
          }
        }
      ]
    }
  ]
}
{% endschema %}
