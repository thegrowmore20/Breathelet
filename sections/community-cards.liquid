{% render 'section-bg-number-vars' %}

{%- capture accent_style -%}
  --primary: {{ section.settings.primary_color }};
  --accent: {{ section.settings.accent_color }};
  --accent-rgb: {{ section.settings.accent_color.rgb }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'cm', style: accent_style %}>
  <div class="section-body">
    <div class="cm-row">
      {%- for block in section.blocks -%}
        <article
          class="cm-card"
          data-animation="block"
          data-animation-group="{{ section.id }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                widths: '352, 550, 832, 1200, 1500',
                sizes: '(min-width: 768px) 50vw, 100vw',
                loading: 'lazy',
                alt: block.settings.image.alt
            }}
          {%- endif -%}
          <div class="cm-shade"></div>
          {%- if block.settings.button_link != blank -%}
            <a class="cm-go" href="{{ block.settings.button_link }}" aria-label="{{ block.settings.button_label | escape }}">↗</a>
          {%- endif -%}
          <div class="cm-tx">
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a
                class="btn {% if block.settings.button_style == 'white' %}btn-w{% else %}btn-ac{% endif %}"
                href="{{ block.settings.button_link }}"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cm {
    --cm-line: rgb(var(--color-foreground) / 10%);
    --cm-ac: var(--accent);
  }

  .cm-row {
    display: flex;
    gap: clamp(12px, 1.4vw, 20px);
    height: min(660px, 78svh);
    min-height: 460px;
  }

  .cm-card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--cm-line);
  }

  .cm-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cm-card:hover img {
    transform: scale(1.06);
  }

  .cm-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgb(var(--cm-shade-rgb, 0 0 0) / 94%) 0%,
      rgb(var(--cm-shade-rgb, 0 0 0) / 65%) 40%,
      rgb(var(--cm-shade-rgb, 0 0 0) / 5%) 72%
    );
  }

  .cm-go {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground) / 55%);
    background: rgb(var(--cm-shade-rgb, 0 0 0) / 25%);
    backdrop-filter: blur(8px);
    display: grid;
    place-items: center;
    font-size: 20px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cm-card:hover .cm-go {
    background: var(--cm-ac);
    border-color: var(--cm-ac);
    color: var(--primary);
    transform: rotate(45deg);
  }

  .cm-tx {
    position: absolute;
    left: clamp(24px, 3.4vw, 56px);
    right: clamp(24px, 3.4vw, 56px);
    bottom: clamp(26px, 4.6vh, 52px);
  }

  .cm-tx h3 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    letter-spacing: -0.015em;
    font-size: clamp(26px, 2.9vw, 42px);
    line-height: 1.12;
    max-width: 560px;
  }

  .cm-tx p {
    color: rgb(var(--color-foreground) / 82%);
    font-size: 15px;
    line-height: 1.7;
    max-width: 440px;
    margin: 16px 0 26px;
  }

  .cm .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 26px;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .cm .btn-ac {
    background: var(--cm-ac);
    color: var(--primary);
  }

  .cm .btn-ac:hover {
    background: rgb(var(--accent-rgb) / 85%);
  }

  .cm .btn-w {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    padding: 0 28px;
    font-size: 13px;
  }

  .cm .btn-w:hover {
    background: var(--cm-ac);
  }

  @media (max-width: 767px) {
    .cm-row {
      flex-direction: column;
      height: auto;
    }

    .cm-card {
      flex: none;
      height: min(520px, 70svh);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Community cards",
  "class": "section-community-cards",
  "max_blocks": 3,
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F0EE" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Secondary (accent)", "default": "#A57C72" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join Our Influencer Community" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Share mindful living, everyday calm, and meaningful wellness with your audience through authentic content." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Become an Influencer" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "accent", "label": "Accent" },
            { "value": "white", "label": "White" }
          ],
          "default": "accent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community cards",
      "blocks": [
        { "type": "card" },
        {
          "type": "card",
          "settings": {
            "heading": "Partner With Breathelet",
            "text": "Bring mindful wellness to your customers with wholesale pricing designed for retailers, distributors, and gift programs.",
            "button_label": "Get Wholesale Quote",
            "button_style": "white"
          }
        }
      ]
    }
  ]
}
{% endschema %}
