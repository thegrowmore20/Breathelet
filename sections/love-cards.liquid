{% render 'section-bg-number-vars' %}

<section {% render 'section-attrs', class: 'hz' %}>
  <div class="hz-stage">
    <div class="section-body hz-head" data-animation="block" data-animation-group="{{ section.id }}-head">
      {%- if section.settings.heading != blank -%}
        <div><h2>{{ section.settings.heading }}</h2></div>
      {%- endif -%}
    </div>

    <div class="section-body">
      <div class="hz-track">
        {%- for block in section.blocks -%}
          <div
            class="fcard"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            <span class="n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            {%- case block.settings.icon -%}
              {%- when 'smile' -%}
                <svg class="ico" viewBox="0 0 48 48" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="24" cy="24" r="17"/><path d="M15 22c1.2-2 3.8-2 5 0M28 22c1.2-2 3.8-2 5 0"/><path d="M14 28c2 7 18 7 20 0z"/></svg>
              {%- when 'sunrise' -%}
                <svg class="ico" viewBox="0 0 48 48" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 36h28"/><path d="M14 36a10 10 0 0 1 20 0"/><path d="M24 12v5M13 17l3 3M35 17l-3 3M8 27h4M36 27h4"/><path d="M14 41c4-2 8 2 12 0s6-1 8 0"/></svg>
              {%- when 'reset' -%}
                <svg class="ico" viewBox="0 0 48 48" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M36 17A14 14 0 1 0 38 26" stroke-dasharray="1 4.5"/><path d="M30 17h8V9" /><path d="M38 17l-6-6" opacity="0"/></svg>
              {%- when 'mind' -%}
                <svg class="ico" viewBox="0 0 48 48" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 40V30c-4-3-6-7-6-11 0-8 6-12 12-12 7 0 12 4 12 11 0 4-2 6-2 8l3 3-4 2v6c0 1-1 3-3 3z"/><path d="M19 17c0-2 3-3 4-1 1-2 4-1 4 1 0 2-4 5-4 5s-4-3-4-5z"/></svg>
              {%- when 'care' -%}
                <svg class="ico" viewBox="0 0 48 48" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M24 22c-6-5-8-8-6-11 2-3 5-2 6 1 1-3 4-4 6-1 2 3 0 6-6 11z"/><path d="M6 28c4-2 8 0 11 3l8 2c2 1 2 3 0 3l-9-1M42 28c-4-2-8 0-11 3M24 40l-12 0M24 40l12 0"/><path d="M6 28v12M42 28v12"/></svg>
              {%- when 'gift' -%}
                <svg class="ico" viewBox="0 0 48 48" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="21" width="30" height="20" rx="2"/><path d="M6 15h34v6H6zM23 15v26"/><path d="M23 15c-6-1-10-3-9-7 1-3 6-2 9 4 0 0 4-7 9-4 3 3-1 6-9 7z"/><path d="M40 8v6M37 11h6" /></svg>
            {%- endcase -%}
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            <i class="ul"></i>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="hz-cta">
        <a class="btn btn-ac" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .section.hz {
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
    --hz-line: rgb(var(--color-foreground) / 10%);
    --hz-tx2: rgb(var(--color-foreground) / 65%);
    --hz-ac: rgb(var(--button-primary-background));
  }

  .hz-stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(36px, 6vh, 64px) 0;
    gap: clamp(24px, 4.5vh, 40px);
  }

  .hz-head {
    text-align: center;
  }

  .hz h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.05;
    font-size: clamp(28px, 3.4vw, 42px);
  }

  .hz h2 em {
    font-style: italic;
    color: var(--hz-ac);
  }

  .hz-track {
    display: flex;
    gap: 24px;
    min-width: 100%;
  }

  .fcard {
    flex: 1 0 180px;
    height: min(280px, 38svh);
    border: 1px solid var(--hz-line);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0;
  }

  .fcard:hover {
    border-color: rgb(var(--button-primary-background) / 70%);
  }

  .fcard .n {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--hz-tx2);
  }

  .fcard .ico {
    width: 46px;
    height: 46px;
    stroke: rgb(var(--color-foreground));
    fill: none;
    stroke-width: 1.5;
    margin: 22px 0 20px;
  }

  .fcard h3 {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: clamp(15px, 1.3vw, 17px);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
  }

  .fcard .ul {
    display: block;
    width: 34px;
    height: 1px;
    background: var(--hz-tx2);
    margin-top: 20px;
  }

  .fcard:hover .ul {
    width: 56px;
    background: var(--hz-ac);
  }

  .fcard:hover .ico {
    stroke: var(--hz-ac);
  }

  .hz-cta {
    text-align: center;
  }

  .hz .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 26px;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .hz .btn-ac {
    background: rgb(var(--button-primary-background));
    color: rgb(var(--button-primary-foreground));
  }

  .hz .btn-ac:hover {
    background: rgb(var(--button-primary-background-hover, var(--button-primary-background)));
  }

  @media (max-width: 575px) {
    .hz-track {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }

    .fcard {
      flex-basis: 78vw;
      scroll-snap-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Love cards",
  "class": "section-love-cards",
  "max_blocks": 8,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> for the accent colour.", "default": "Why do people love <em>Breathelet?</em>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Breathelet" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F0EE" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "smile", "label": "Smile" },
            { "value": "sunrise", "label": "Sunrise" },
            { "value": "reset", "label": "Reset" },
            { "value": "mind", "label": "Mind" },
            { "value": "care", "label": "Care" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "smile"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feel Present Again" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Love cards",
      "blocks": [
        { "type": "card", "settings": { "icon": "smile", "title": "Feel Present Again" } },
        { "type": "card", "settings": { "icon": "sunrise", "title": "Calm That Fits Your Day" } },
        { "type": "card", "settings": { "icon": "reset", "title": "Reset Anywhere, Anytime" } },
        { "type": "card", "settings": { "icon": "mind", "title": "Mindful Habits" } },
        { "type": "card", "settings": { "icon": "care", "title": "Screenless Wellness" } },
        { "type": "card", "settings": { "icon": "gift", "title": "Meaningful Gift" } }
      ]
    }
  ]
}
{% endschema %}
