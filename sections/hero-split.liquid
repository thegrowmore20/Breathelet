<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color | default: '#f4f3f0' }};
  }

  .hs-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: {{ section.settings.min_height | default: 680 }}px;
    overflow: hidden;
    position: relative;
  }

  /* ── LEFT: TEXT ─────────────────────────────── */
  .hs-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 72px 48px 72px 72px;
  }

  .hs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(0,0,0,0.18);
    border-radius: 100px;
    padding: 6px 16px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 28px;
    width: fit-content;
    color: #333;
  }

  .hs-eyebrow-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    flex-shrink: 0;
  }

  .hs-heading {
    font-size: clamp(2.4rem, 3.8vw, 3.8rem);
    line-height: 1.08;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: {{ section.settings.heading_color | default: '#111111' }};
    font-family: var(--font-heading-family, sans-serif);
  }

  .hs-heading em {
    font-style: italic;
    color: {{ section.settings.heading_italic_color | default: '#999999' }};
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
  }

  .hs-body {
    font-size: 15px;
    line-height: 1.65;
    color: {{ section.settings.text_color | default: '#555555' }};
    max-width: 400px;
    margin-bottom: 32px;
  }

  .hs-ctas {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .hs-btn-primary {
    background: {{ section.settings.btn_bg | default: '#111111' }};
    color: {{ section.settings.btn_color | default: '#ffffff' }};
    border: none;
    padding: 14px 26px;
    border-radius: 100px;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity 0.2s;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .hs-btn-primary:hover { opacity: 0.72; color: {{ section.settings.btn_color | default: '#ffffff' }}; }

  .hs-btn-video {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: {{ section.settings.heading_color | default: '#111111' }};
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .hs-btn-video:hover { opacity: 1; color: {{ section.settings.heading_color | default: '#111111' }}; }

  .hs-play {
    width: 36px;
    height: 36px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .hs-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: {{ section.settings.text_color | default: '#555555' }};
  }
  .hs-stars {
    color: {{ section.settings.heading_color | default: '#111111' }};
    font-size: 15px;
    letter-spacing: 1px;
    line-height: 1;
  }
  .hs-rating strong { color: {{ section.settings.heading_color | default: '#111111' }}; }

  /* ── RIGHT: IMAGE ───────────────────────────── */
  .hs-image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hs-watermark {
    position: absolute;
    bottom: -8%;
    left: -4%;
    right: 0;
    font-size: clamp(90px, 18vw, 210px);
    font-weight: 700;
    color: rgba(0,0,0,0.045);
    white-space: nowrap;
    pointer-events: none;
    line-height: 1;
    user-select: none;
    font-family: 'Instrument Serif', Georgia, serif;
    letter-spacing: -0.04em;
  }

  .hs-product {
    position: relative;
    z-index: 1;
    width: 52%;
    max-width: 300px;
  }
  .hs-product img { width: 100%; height: auto; display: block; }

  .hs-chips { position: absolute; inset: 0; z-index: 2; pointer-events: none; }

  .hs-chip {
    position: absolute;
    background: #ffffff;
    border-radius: 100px;
    padding: 8px 14px 8px 10px;
    font-size: 12px;
    color: #111;
    white-space: nowrap;
    box-shadow: 0 2px 14px rgba(0,0,0,0.09);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .hs-chip-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #111;
    flex-shrink: 0;
  }

  /* ── TRUST STRIP ────────────────────────────── */
  .hs-trust {
    border-top: 1px solid rgba(0,0,0,0.09);
    padding: 14px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 44px;
    flex-wrap: wrap;
    background: rgba(0,0,0,0.03);
  }

  .hs-trust-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: #444;
  }
  .hs-trust-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #333;
    flex-shrink: 0;
  }

  /* ── MOBILE ─────────────────────────────────── */
  @media (max-width: 767px) {
    .hs-wrap {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .hs-image {
      min-height: 360px;
      order: -1;
    }
    .hs-text {
      padding: 36px 24px 40px;
    }
    .hs-heading { font-size: 2.2rem; }
    .hs-chip { display: none; }
    .hs-trust {
      gap: 14px;
      padding: 12px 20px;
      justify-content: flex-start;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hs-text { padding: 48px 32px 48px 48px; }
    .hs-heading { font-size: 2.8rem; }
  }
</style>

<div id="shopify-section-{{ section.id }}" class="hero-split-section">
  <div class="hs-wrap">

    {%- comment -%} TEXT COLUMN {%- endcomment -%}
    <div class="hs-text">
      {%- if section.settings.eyebrow != blank -%}
        <div class="hs-eyebrow">
          <span class="hs-eyebrow-dot"></span>
          {{- section.settings.eyebrow -}}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hs-heading">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_italic != blank -%}
            <br><em>{{- section.settings.heading_italic -}}</em>
          {%- endif -%}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="hs-body">{{- section.settings.text -}}</p>
      {%- endif -%}

      <div class="hs-ctas">
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="hs-btn-primary">
            {{- section.settings.button_text -}} →
          </a>
        {%- endif -%}
        {%- if section.settings.video_text != blank -%}
          <a href="{{ section.settings.video_link | default: '#' }}" class="hs-btn-video">
            <span class="hs-play">
              <svg width="9" height="11" viewBox="0 0 9 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L8 5.5L1 10V1Z" fill="currentColor"/>
              </svg>
            </span>
            {{- section.settings.video_text -}}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_rating -%}
        <div class="hs-rating">
          <span class="hs-stars">★★★★★</span>
          <strong>{{ section.settings.rating_score | default: '4.2' }}</strong>
          <span>{{ section.settings.rating_text | default: 'from 100 reviews' }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} IMAGE COLUMN {%- endcomment -%}
    <div class="hs-image">
      {%- if section.settings.watermark != blank -%}
        <div class="hs-watermark">{{ section.settings.watermark }}</div>
      {%- endif -%}

      <div class="hs-product">
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag:
              loading: 'eager',
              widths: '400, 600, 800',
              alt: section.settings.image.alt | default: shop.name
          }}
        {%- else -%}
          {%- render 'placeholder', type: 'product' -%}
        {%- endif -%}
      </div>

      <div class="hs-chips">
        {%- if section.settings.chip_1 != blank -%}
          <div class="hs-chip" style="top: 36%; right: 7%;">
            {{- section.settings.chip_1 -}}
            <span class="hs-chip-dot"></span>
          </div>
        {%- endif -%}
        {%- if section.settings.chip_2 != blank -%}
          <div class="hs-chip" style="top: 53%; right: 3%;">
            {{- section.settings.chip_2 -}}
          </div>
        {%- endif -%}
        {%- if section.settings.chip_3 != blank -%}
          <div class="hs-chip" style="top: 70%; right: 8%;">
            {{- section.settings.chip_3 -}}
            <span class="hs-chip-dot"></span>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>

  {%- comment -%} TRUST STRIP {%- endcomment -%}
  {%- assign has_trust = false -%}
  {%- for i in (1..4) -%}
    {%- assign k = 'trust_' | append: i -%}
    {%- if section.settings[k] != blank -%}{%- assign has_trust = true -%}{%- endif -%}
  {%- endfor -%}
  {%- if has_trust -%}
    <div class="hs-trust">
      {%- for i in (1..4) -%}
        {%- assign k = 'trust_' | append: i -%}
        {%- if section.settings[k] != blank -%}
          <span class="hs-trust-item">
            <span class="hs-trust-dot"></span>
            {{- section.settings[k] -}}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

