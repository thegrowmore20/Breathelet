{% liquid
  assign philosophy_video_url = 'https://breathelet.com/cdn/shop/videos/c/vp/e74e973f4ad544b8be5d6086e3271228/e74e973f4ad544b8be5d6086e3271228.SD-480p-1.5Mbps-74686052.mp4'
%}

<style>
  #shopify-section-{{ section.id }} .phil {
    --phil-ink: #0b0b0b;
    --phil-serif: var(--font-heading-family, Georgia, serif);
    --phil-sans: var(--font-body-family, system-ui, sans-serif);
    background: transparent;
    margin: 0 16px;
    padding: 0;
    color: #fff;
    isolation: isolate;
    position: relative;
  }

  #shopify-section-{{ section.id }} .phil-bg {
    position: absolute;
    inset: 0;
    background: #000;
    border-radius: 48px;
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .phil .eyebrow,
  #shopify-section-{{ section.id }} .phil .subheading {
    color: #8f8f8c;
  }

  #shopify-section-{{ section.id }} .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  #shopify-section-{{ section.id }} .phil-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .phil-copy {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .phil-copy .subheading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .phil-copy .h0,
  #shopify-section-{{ section.id }} .phil-copy .h1,
  #shopify-section-{{ section.id }} .phil-copy .h2,
  #shopify-section-{{ section.id }} .phil-copy .h3,
  #shopify-section-{{ section.id }} .phil-copy .h4,
  #shopify-section-{{ section.id }} .phil-copy .h5,
  #shopify-section-{{ section.id }} .phil-copy .h6 {
    margin-top: 18px;
    font-family: var(--phil-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .phil-copy :where(.h0, .h1, .h2, .h3, .h4, .h5, .h6) em {
    color: #A57C72;
    font-style: italic;
  }

  #shopify-section-{{ section.id }} .phil-copy .prose {
    color: #b5b5b2;
    max-width: 460px;
    margin-top: 26px;
    font-family: var(--phil-sans);
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .phil-copy .prose p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .phil-copy .quote-card {
    margin-top: 32px;
    padding: 0 0 0 24px;
    border-left: 1px solid #b7897f;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .phil-copy .quote-card .profile-container {
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .phil-copy .quote-card .author-name {
    color: #fff;
    font-family: var(--phil-sans);
  }

  #shopify-section-{{ section.id }} .phil-copy .quote-card .author-designation {
    color: #b5b5b2;
    font-family: var(--phil-sans);
  }

  #shopify-section-{{ section.id }} .phil-copy .quote-card .quote-content p {
    color: #fff;
    font-family: var(--phil-sans);
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.35;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .stats {
    display: flex;
    gap: 46px;
    margin-top: 40px;
  }

  #shopify-section-{{ section.id }} .stats b {
    display: block;
    font-family: var(--phil-serif);
    font-weight: 400;
    font-size: clamp(40px, 4vw, 54px);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .stats span {
    font-family: var(--phil-sans);
    font-size: 11px;
    font-weight: 600;
    color: #8f8f8c;
    letter-spacing: 0.08em;
  }

  #shopify-section-{{ section.id }} .vid {
    position: relative;
    border-radius: 36px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #000;
    margin: 0 auto;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .vid video-player,
  #shopify-section-{{ section.id }} .vid video,
  #shopify-section-{{ section.id }} .vid video-player > div {
    display: block;
    width: 100%;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .vid video {
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .vid-tag {
    position: absolute;
    left: 18px;
    bottom: 18px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--phil-ink);
    backdrop-filter: blur(10px);
    border-radius: 99px;
    padding: 9px 16px;
    font-family: var(--phil-sans);
    font-size: 12px;
    font-weight: 500;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .vid-tag i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--phil-ink);
    animation: philosophy-beat-{{ section.id }} 5.5s ease-in-out infinite;
  }

  @keyframes philosophy-beat-{{ section.id }} {
    0%, 100% { opacity: 0.35; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @media (max-width: 980px) {
    #shopify-section-{{ section.id }} .wrap {
      padding: 0 22px;
    }

    #shopify-section-{{ section.id }} .phil-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 560px) {
    #shopify-section-{{ section.id }} .phil {
      margin: 0 8px;
    }

    #shopify-section-{{ section.id }} .phil-bg {
      border-radius: 32px;
    }

    #shopify-section-{{ section.id }} .vid-tag {
      left: 14px;
      bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .vid-tag i {
      animation: none;
    }
  }
</style>

{% render 'section-bg-number-vars' %}

<section class="section section--full-width" id="how">
  <div class="phil">
    <div class="phil-bg" id="philBg"></div>
    <div class="wrap phil-grid" id="philIn" data-animation-auto-order>
    <div class="phil-copy">
      {% render 'rich-text-blocks', prose_class: 'prose', heading_emphasis: 'Deep Breath' %}
      <div class="stats">
        <div><b>{{ section.settings.stat_1_value }}</b><span>{{ section.settings.stat_1_label }}</span></div>
        <div><b>{{ section.settings.stat_2_value }}</b><span>{{ section.settings.stat_2_label }}</span></div>
        <div><b>{{ section.settings.stat_3_value }}</b><span>{{ section.settings.stat_3_label }}</span></div>
      </div>
    </div>
    <div class="vid" data-animation="block" data-animation-group="{{ section.id }}">
      {% if section.settings.video != blank %}
        {% render 'video-player', video: section.settings.video, video_poster: section.settings.video_poster, background: section.settings.autoplay, loop: section.settings.loop, muted: true %}
      {% else %}
        <video
          src="{{ philosophy_video_url }}"
          {% if section.settings.autoplay %}autoplay{% endif %}
          muted
          {% if section.settings.loop %}loop{% endif %}
          playsinline
          preload="metadata"
          {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | image_url: width: 1200 }}"{% endif %}
        ></video>
      {% endif %}
      <div class="vid-tag"><i></i>{{ section.settings.video_label }}</div>
    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Philosophy",
  "class": "section-philosophy overflow-hidden",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "video_poster", "label": "Video poster" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay video", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop video", "default": true },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "Inhale 5.5s · Exhale 5.5s" },
    { "type": "text", "id": "stat_1_value", "label": "Statistic 1 value", "default": "5.5s" },
    { "type": "text", "id": "stat_1_label", "label": "Statistic 1 label", "default": "INHALE" },
    { "type": "text", "id": "stat_2_value", "label": "Statistic 2 value", "default": "5.5s" },
    { "type": "text", "id": "stat_2_label", "label": "Statistic 2 label", "default": "EXHALE" },
    { "type": "text", "id": "stat_3_value", "label": "Statistic 3 value", "default": "150×" },
    { "type": "text", "id": "stat_3_label", "label": "Statistic 3 label", "default": "PHONE CHECKS / DAY" }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "The philosophy" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "A Proper Conscious, Deep Breath" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h0", "label": "3X-Large" },
            { "value": "h1", "label": "2X-Large" },
            { "value": "h2", "label": "X-Large" },
            { "value": "h3", "label": "Large" },
            { "value": "h4", "label": "Medium" },
            { "value": "h5", "label": "Small" },
            { "value": "h6", "label": "X-Small" }
          ],
          "default": "h0"
        },
        {
          "type": "select",
          "id": "heading_html_tag",
          "label": "Heading HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "p", "label": "Paragraph" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Perfect for any wrist, Breathelet helps you stay present, build better routines, and support daily clarity with soft vibration reminders designed to keep you aligned all day. For a full reset, sit straight, relax your shoulders, inhale deeply through your nose, let your breath expand, then exhale slowly and completely.</p>"
        }
      ]
    },
    {
      "type": "bio",
      "name": "Bio Quote",
      "settings": [
        { "type": "image_picker", "id": "author_image", "label": "Author image" },
        { "type": "text", "id": "author_name", "label": "Author name", "default": "James Nestor" },
        { "type": "text", "id": "author_designation", "label": "Designation", "default": "Famous researcher on breathing" },
        { "type": "inline_richtext", "id": "quotation_text", "label": "Quote content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
