{% liquid
  assign philosophy_video_url = 'https://breathelet.com/cdn/shop/videos/c/vp/e74e973f4ad544b8be5d6086e3271228/e74e973f4ad544b8be5d6086e3271228.SD-480p-1.5Mbps-74686052.mp4'
%}

{% render 'section-bg-number-vars' %}

<section {% render 'section-attrs', class: 'phil-section' %} id="how">
  <div class="section-body">
    <div class="phil relative">
      <div class="phil-bg absolute inset-0" id="philBg"></div>
      <div class="wrap w-full grid items-center phil-grid" id="philIn" data-animation-auto-order>
        <div class="phil-copy">
          {% render 'rich-text-blocks', prose_class: 'prose', heading_emphasis: 'Deep Breath' %}
          <philosophy-stats class="stats flex">
            <div data-animation="block" data-animation-group="{{ section.id }}"><b>{{ section.settings.stat_1_value }}</b><span>{{ section.settings.stat_1_label }}</span></div>
            <div data-animation="block" data-animation-group="{{ section.id }}"><b>{{ section.settings.stat_2_value }}</b><span>{{ section.settings.stat_2_label }}</span></div>
            <div data-animation="block" data-animation-group="{{ section.id }}"><b>{{ section.settings.stat_3_value }}</b><span>{{ section.settings.stat_3_label }}</span></div>
          </philosophy-stats>
        </div>
        <div class="vid relative overflow-hidden w-full mx-auto" data-animation="block" data-animation-group="{{ section.id }}">
          {% if section.settings.video != blank %}
            {% render 'video-player', video: section.settings.video, video_poster: section.settings.video_poster, background: section.settings.autoplay, loop: section.settings.loop, muted: true %}
          {% else %}
            <video
              src="{{ philosophy_video_url }}"
              data-autoplay="{{ section.settings.autoplay }}"
              muted
              {% if section.settings.loop %}loop{% endif %}
              playsinline
              preload="none"
              {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | image_url: width: 1200 }}"{% endif %}
            ></video>
          {% endif %}
          <div class="vid-tag absolute flex items-center gap-2 rounded-full"><i class="rounded-full" aria-hidden="true"></i>{{ section.settings.video_label }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .phil-section {
    content-visibility: auto;
    contain-intrinsic-size: auto 600px;
  }

  .phil-section .phil {
    background: transparent;
    color: rgb(var(--color-foreground));
    isolation: isolate;
  }

  .phil-section .phil-bg {
    background: rgb(var(--color-background));
    border-radius: 48px;
    z-index: -1;
  }

  .phil-section .phil .eyebrow,
  .phil-section .phil .subheading {
    color: rgb(var(--color-foreground) / 56%);
  }

  .phil-section .phil-grid {
    grid-template-columns: 1.1fr 1fr;
    gap: 70px;
  }

  .phil-section .phil-copy {
    min-width: 0;
  }

  .phil-section .phil-copy .subheading {
    margin: 0;
  }

  .phil-section .phil-copy :where(.h0, .h1, .h2, .h3, .h4, .h5, .h6) {
    margin-top: 18px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
    color: rgb(var(--color-foreground));
  }

  .phil-section .phil-copy .prose {
    color: rgb(var(--color-foreground) / 72%);
    max-width: 460px;
    margin-top: 26px;
    font-size: clamp(15px, 1.3vw, 17px);
    line-height: 1.5;
  }

  .phil-section .phil-copy .prose p {
    margin: 0;
  }

  .phil-section .phil-copy .quote-card {
    margin-top: 32px;
    padding: 0 0 0 24px;
    border-left: 1px solid rgb(var(--color-heading-accent, 165 124 114));
    color: rgb(var(--color-foreground));
  }

  .phil-section .phil-copy .quote-card .profile-container {
    margin-bottom: 16px;
  }

  .phil-section .phil-copy .quote-card .author-name {
    color: rgb(var(--color-foreground));
  }

  .phil-section .phil-copy .quote-card .author-designation {
    color: rgb(var(--color-foreground) / 72%);
  }

  .phil-section .phil-copy .quote-card .quote-content p {
    color: rgb(var(--color-foreground));
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.35;
    margin: 0;
  }

  .phil-section .stats {
    gap: 46px;
    margin-top: 40px;
  }

  .phil-section .stats b {
    display: block;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: clamp(40px, 4vw, 54px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .phil-section .stats span {
    font-size: 11px;
    font-weight: 600;
    color: rgb(var(--color-foreground) / 56%);
    letter-spacing: 0.08em;
  }

  .phil-section .vid {
    border-radius: 36px;
    aspect-ratio: 1 / 1;
    background: rgb(var(--color-background));
  }

  .phil-section .vid video-player,
  .phil-section .vid video,
  .phil-section .vid video-player > div {
    display: block;
    width: 100%;
    height: 100%;
  }

  .phil-section .vid video {
    object-fit: cover;
  }

  .phil-section .vid-tag {
    left: 18px;
    bottom: 18px;
    background: rgb(var(--color-foreground) / 90%);
    color: rgb(var(--color-background));
    backdrop-filter: blur(10px);
    padding: 9px 16px;
    font-size: 12px;
    font-weight: 500;
  }

  .phil-section .vid-tag i {
    width: 7px;
    height: 7px;
    background: rgb(var(--color-background));
    animation: philosophy-beat 5.5s ease-in-out infinite;
  }

  @keyframes philosophy-beat {
    0%, 100% { opacity: 0.35; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @media (max-width: 991px) {
    .phil-section .phil-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 575px) {
    .phil-section .phil-bg {
      border-radius: 32px;
    }

    .phil-section .vid-tag {
      left: 14px;
      bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phil-section .vid-tag i {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('philosophy-stats')) {
    class PhilosophyStats extends HTMLElement {
      connectedCallback() {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const sectionEl = this.closest('section');
        const vid = sectionEl ? sectionEl.querySelector('video[data-autoplay="true"]') : null;
        if (vid && !reduced && 'IntersectionObserver' in window) {
          this._vidObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  vid.play().catch(() => {});
                } else if (!vid.paused) {
                  vid.pause();
                }
              }
            },
            { rootMargin: '150px 0px', threshold: 0.05 }
          );
          this._vidObserver.observe(vid);
        }

        if (reduced || !('IntersectionObserver' in window)) {
          return;
        }

        const targets = [];
        for (const el of this.querySelectorAll('b')) {
          const raw = el.textContent.trim();
          const match = raw.match(/^([^0-9.-]*)(-?\d+(?:\.\d+)?)(.*)$/);
          if (!match) continue;
          const decimals = match[2].includes('.') ? match[2].split('.')[1].length : 0;
          targets.push({
            el,
            prefix: match[1],
            end: parseFloat(match[2]),
            decimals,
            suffix: match[3],
          });
        }

        if (!targets.length) return;

        this._observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              this._observer.disconnect();
              this._animate(targets);
              break;
            }
          },
          { threshold: 0.35 }
        );

        this._observer.observe(this);
      }

      _animate(targets) {
        const duration = 1200;
        const start = performance.now();

        const step = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);

          for (const item of targets) {
            const val = item.end * eased;
            const formatted = item.decimals > 0 ? val.toFixed(item.decimals) : String(Math.round(val));
            item.el.textContent = item.prefix + formatted + item.suffix;
          }

          if (progress < 1) {
            this._raf = requestAnimationFrame(step);
          }
        };

        this._raf = requestAnimationFrame(step);
      }

      disconnectedCallback() {
        if (this._observer) this._observer.disconnect();
        if (this._vidObserver) this._vidObserver.disconnect();
        if (this._raf) cancelAnimationFrame(this._raf);
      }
    }

    customElements.define('philosophy-stats', PhilosophyStats);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Philosophy",
  "class": "section-philosophy overflow-hidden",
  "settings": [
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "image_picker", "id": "video_poster", "label": "Video poster" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay video", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop video", "default": true },
    { "type": "text", "id": "video_label", "label": "Video label", "default": "Inhale 5.5s · Exhale 5.5s" },
    { "type": "text", "id": "stat_1_value", "label": "Statistic 1 value", "default": "5.5s" },
    { "type": "text", "id": "stat_1_label", "label": "Statistic 1 label", "default": "INHALE" },
    { "type": "text", "id": "stat_2_value", "label": "Statistic 2 value", "default": "5.5s" },
    { "type": "text", "id": "stat_2_label", "label": "Statistic 2 label", "default": "EXHALE" },
    { "type": "text", "id": "stat_3_value", "label": "Statistic 3 value", "default": "150×" },
    { "type": "text", "id": "stat_3_label", "label": "Statistic 3 label", "default": "PHONE CHECKS / DAY" }
  ],
  "blocks": [
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "The philosophy" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "A Proper Conscious, Deep Breath" },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            { "value": "h0", "label": "3X-Large" },
            { "value": "h1", "label": "2X-Large" },
            { "value": "h2", "label": "X-Large" },
            { "value": "h3", "label": "Large" },
            { "value": "h4", "label": "Medium" },
            { "value": "h5", "label": "Small" },
            { "value": "h6", "label": "X-Small" }
          ],
          "default": "h0"
        },
        {
          "type": "select",
          "id": "heading_html_tag",
          "label": "Heading HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "p", "label": "Paragraph" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Perfect for any wrist, Breathelet helps you stay present, build better routines, and support daily clarity with soft vibration reminders designed to keep you aligned all day. For a full reset, sit straight, relax your shoulders, inhale deeply through your nose, let your breath expand, then exhale slowly and completely.</p>"
        }
      ]
    },
    {
      "type": "bio",
      "name": "Bio Quote",
      "settings": [
        { "type": "image_picker", "id": "author_image", "label": "Author image" },
        { "type": "text", "id": "author_name", "label": "Author name", "default": "James Nestor" },
        { "type": "text", "id": "author_designation", "label": "Designation", "default": "Famous researcher on breathing" },
        { "type": "inline_richtext", "id": "quotation_text", "label": "Quote content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy",
      "blocks": [
        { "type": "heading" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
