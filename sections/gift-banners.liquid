{% render 'section-bg-number-vars' %}

{%- capture gift_style -%}
  --bn-panel: {{ section.settings.panel_background }};
  --bn-dark-background: {{ section.settings.dark_background }};
  --bn-dark-background-rgb: {{ section.settings.dark_background.rgb }};
  --bn-dark-rgb: {{ section.settings.dark_text.rgb }};
  --primary: {{ section.settings.primary_color }};
  --accent: {{ section.settings.accent_color }};
  --accent-rgb: {{ section.settings.accent_color.rgb }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'gift', style: gift_style %}>
  <div class="section-body">
    <div class="banner">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_light = false
          if block.settings.style == 'light'
            assign is_light = true
          endif
          assign card_product = block.settings.product
          assign btn_link = block.settings.button_link
          if btn_link == blank and card_product != blank
            assign btn_link = card_product.url
          endif
        -%}
        <article
          class="bn {% if is_light %}lt{% else %}dk{% endif %}"
          data-animation="block"
          data-animation-group="{{ section.id }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- assign banner_alt = block.settings.image.alt | default: block.settings.heading | strip_html | default: 'Breathelet gift banner' -%}
            {{
              block.settings.image
              | image_url: width: 1500
              | image_tag:
                class: 'bg',
                widths: '352, 550, 832, 1200, 1500',
                sizes: '(min-width: 992px) 50vw, 100vw',
                loading: 'lazy',
                decoding: 'async',
                alt: banner_alt
            }}
          {%- elsif card_product != blank and card_product.featured_image != blank -%}
            {%- assign prod_alt = card_product.featured_image.alt | default: card_product.title -%}
            {{
              card_product.featured_image
              | image_url: width: 1500
              | image_tag:
                class: 'bg',
                widths: '352, 550, 832, 1200, 1500',
                sizes: '(min-width: 992px) 50vw, 100vw',
                loading: 'lazy',
                decoding: 'async',
                alt: prod_alt
            }}
          {%- endif -%}
          <div class="bn-t">
            {%- if block.settings.eyebrow != blank -%}
              <div class="subheading">{{ block.settings.eyebrow | escape }}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="{{ section.settings.heading_size | default: 'h2' }}">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and btn_link != blank -%}
              <a
                href="{{ btn_link }}"
                class="btn {% if is_light %}btn-dark{% else %}btn-light{% endif %}"
              >
                {{- block.settings.button_label | escape -}}
                {%- if block.settings.show_price and card_product != blank -%}
                  {{- ' · ' -}}{{ card_product.price | money }}
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gift {
    content-visibility: auto;
    contain-intrinsic-size: auto 560px;
  }

  .gift .banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .gift .bn {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    min-height: min(500px, 64svh);
    background: var(--bn-dark-background);
    color: rgb(var(--bn-dark-rgb));
    display: flex;
    align-items: flex-end;
    isolation: isolate;
    border: 1px solid rgb(var(--bn-dark-rgb) / 10%);
    box-shadow: inset 0 1px 0 rgb(var(--bn-dark-rgb) / 6%);
  }

  .gift .bn.lt {
    background: var(--bn-panel);
    border-color: rgb(var(--accent-rgb) / 28%);
  }

  .gift .bn > img.bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: -2;
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .gift .bn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      0deg,
      rgb(var(--bn-dark-background-rgb, 11 10 10) / 96%) 0%,
      rgb(var(--bn-dark-background-rgb, 11 10 10) / 76%) 46%,
      rgb(var(--bn-dark-background-rgb, 11 10 10) / 18%) 78%,
      transparent 100%
    );
    pointer-events: none;
  }

  .gift .bn-t {
    position: relative;
    z-index: 2;
    padding: clamp(28px, 3.4vw, 44px);
    max-width: 540px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  .gift .bn-t .subheading {
    color: var(--accent);
  }

  .gift .bn-t h2 {
    color: rgb(var(--bn-dark-rgb));
    margin: 0;
  }

  .gift .bn-t h2 em {
    font-style: italic;
    color: var(--accent);
    padding-right: 0.08em;
  }

  .gift .bn-t p {
    color: rgb(var(--bn-dark-rgb) / 82%);
    font-size: 15px;
    line-height: 1.6;
    margin: 0;
  }

  .gift .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 28px;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    margin-top: 8px;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .gift .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .gift .btn-dark {
    background: var(--accent);
    color: var(--primary);
  }

  .gift .btn-light {
    background: rgb(var(--bn-dark-rgb));
    color: var(--primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .gift .bn:hover {
      border-color: rgb(var(--accent-rgb) / 55%);
    }

    .gift .bn:hover > img.bg {
      transform: scale(1.05);
    }

    .gift .btn:hover {
      transform: translateY(-2px);
    }

    .gift .btn-dark:hover {
      background: rgb(var(--accent-rgb) / 88%);
    }

    .gift .btn-light:hover {
      background: var(--accent);
    }
  }

  @media (max-width: 991px) {
    .gift .banner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 575px) {
    .gift .bn {
      min-height: 420px;
      border-radius: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift .btn,
    .gift .bn > img.bg {
      transition: none;
    }

    .gift .btn:hover,
    .gift .bn:hover > img.bg {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift banners",
  "class": "section-gift-banners",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "Card heading size",
      "options": [
        { "value": "h0", "label": "3X-Large" },
        { "value": "h1", "label": "2X-Large" },
        { "value": "h2", "label": "X-Large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "X-Small" }
      ],
      "default": "h2"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F0EE" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Secondary (accent)", "default": "#A57C72" },
    { "type": "color", "id": "panel_background", "label": "First banner fallback surface", "default": "#141211" },
    { "type": "color", "id": "dark_background", "label": "Second banner fallback surface", "default": "#0B0A0A" },
    { "type": "color", "id": "dark_text", "label": "Banner text", "default": "#F4F0EE" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Button & border accent",
          "options": [
            { "value": "light", "label": "Accent button" },
            { "value": "dark", "label": "Light button" }
          ],
          "default": "light"
        },
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "product", "id": "product", "label": "Product (optional — dynamic price & link)" },
        { "type": "checkbox", "id": "show_price", "label": "Show product price on button", "default": true },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For someone you love" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> for the italic accent.", "default": "Gift love they’ll <em>remember.</em>" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Give a meaningful daily reminder that keeps your care close, through every soft cue and quiet reset." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Gift Breathelet" },
        { "type": "url", "id": "button_link", "label": "Button link (overrides product link)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift banners",
      "blocks": [
        { "type": "banner", "settings": { "style": "light", "show_price": false } },
        {
          "type": "banner",
          "settings": {
            "style": "dark",
            "show_price": true,
            "eyebrow": "Eternal Love Pair",
            "heading": "Two Breathelets. <em>One connection.</em>",
            "text": "One shared reminder to breathe, reset, and stay present — together.",
            "button_label": "Buy the Pair"
          }
        }
      ]
    }
  ]
}
{% endschema %}
