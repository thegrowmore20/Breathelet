{% render 'section-bg-number-vars' %}

{%- capture gift_style -%}
  --bn-panel: {{ section.settings.panel_background }};
  --bn-dark-background: {{ section.settings.dark_background }};
  --bn-dark-background-rgb: {{ section.settings.dark_background.rgb }};
  --bn-dark-rgb: {{ section.settings.dark_text.rgb }};
  --primary: {{ section.settings.primary_color }};
  --accent: {{ section.settings.accent_color }};
  --accent-rgb: {{ section.settings.accent_color.rgb }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'gift', style: gift_style %}>
  <div class="section-body">
    <div class="banner">
      {%- for block in section.blocks -%}
        {%- assign is_light = false -%}
        {%- if block.settings.style == 'light' -%}
          {%- assign is_light = true -%}
        {%- endif -%}
        <div
          class="bn {% if is_light %}lt{% else %}dk{% endif %}"
          data-animation="block"
          data-animation-group="{{ section.id }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- if is_light -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'pimg',
                  widths: '352, 550, 832, 1200',
                  sizes: '(min-width: 992px) 30vw, 52vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'bg',
                  widths: '352, 550, 832, 1200',
                  sizes: '(min-width: 992px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
          {%- endif -%}
          <div class="bn-t">
            {%- if block.settings.eyebrow != blank -%}
              <div class="eyebrow">{{ block.settings.eyebrow | escape }}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a
                href="{{ block.settings.button_link }}"
                class="btn {% if is_light %}btn-dark{% else %}btn-light{% endif %}"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gift .eyebrow {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }

  .gift .banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .gift .bn {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    min-height: min(450px, 58svh);
    background: var(--bn-dark-background);
    color: rgb(var(--bn-dark-rgb));
    display: flex;
    align-items: flex-end;
    border: 1px solid rgb(var(--bn-dark-rgb) / 10%);
    box-shadow: inset 0 1px 0 rgb(var(--bn-dark-rgb) / 6%);
  }

  .gift .bn > img.bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4% 4% 38% 36%;
    filter: drop-shadow(0 24px 32px rgb(0 0 0 / 55%));
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .gift .bn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgb(var(--bn-dark-background-rgb, 11 10 10) / 96%) 0%,
      rgb(var(--bn-dark-background-rgb, 11 10 10) / 72%) 42%,
      transparent 72%
    );
    pointer-events: none;
  }

  .gift .bn-t {
    position: relative;
    z-index: 2;
    padding: clamp(28px, 3.2vw, 40px);
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .gift .bn-t h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.05;
    font-size: clamp(32px, 3.4vw, 48px);
    color: rgb(var(--bn-dark-rgb));
  }

  .gift .bn-t h2 em {
    font-style: italic;
    color: var(--accent);
    padding-right: 0.08em;
  }

  .gift .bn-t p {
    color: rgb(var(--bn-dark-rgb) / 78%);
    font-size: 15px;
    line-height: 1.6;
  }

  .gift .bn.lt {
    background: radial-gradient(circle at 80% 42%, rgb(var(--accent-rgb) / 18%), transparent 54%), var(--bn-panel);
    color: rgb(var(--bn-dark-rgb));
    border-color: rgb(var(--accent-rgb) / 30%);
  }

  .gift .bn.lt::after {
    display: none;
  }

  .gift .bn.lt .pimg {
    position: absolute;
    right: -1%;
    top: 4%;
    width: 58%;
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 28px 34px rgb(0 0 0 / 55%));
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .gift .bn.lt .bn-t {
    max-width: 58%;
  }

  .gift .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 28px;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    margin-top: 6px;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .gift .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .gift .btn-dark {
    background: var(--accent);
    color: var(--primary);
  }

  .gift .btn-light {
    background: rgb(var(--bn-dark-rgb));
    color: var(--primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .gift .bn {
      transition: transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .gift .bn:hover {
      transform: translateY(-4px);
      border-color: rgb(var(--accent-rgb) / 55%);
    }

    .gift .bn:hover .pimg,
    .gift .bn:hover > img.bg {
      transform: scale(1.04);
    }

    .gift .btn:hover {
      transform: translateY(-2px);
    }

    .gift .btn-dark:hover {
      background: rgb(var(--accent-rgb) / 88%);
    }

    .gift .btn-light:hover {
      background: var(--accent);
    }
  }

  @media (max-width: 991px) {
    .gift .banner {
      grid-template-columns: 1fr;
    }

    .gift .bn.lt .bn-t {
      max-width: 66%;
    }

    .gift .bn.lt .pimg {
      width: 48%;
      top: 4%;
    }
  }

  @media (max-width: 575px) {
    .gift .bn {
      min-height: 390px;
      border-radius: 24px;
    }

    .gift .bn.lt .bn-t {
      max-width: none;
      padding-top: 180px;
    }

    .gift .bn.lt .pimg {
      width: 56%;
      right: 4%;
      top: 2%;
    }

    .gift .bn > img.bg {
      padding: 4% 4% 46% 24%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift .bn,
    .gift .btn,
    .gift .bn.lt .pimg,
    .gift .bn > img.bg {
      transition: none;
    }

    .gift .bn:hover,
    .gift .btn:hover,
    .gift .bn:hover .pimg,
    .gift .bn:hover > img.bg {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift banners",
  "class": "section-gift-banners",
  "max_blocks": 2,
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F0EE" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Secondary (accent)", "default": "#A57C72" },
    { "type": "color", "id": "panel_background", "label": "First banner surface", "default": "#141211" },
    { "type": "color", "id": "dark_background", "label": "Second banner surface", "default": "#0B0A0A" },
    { "type": "color", "id": "dark_text", "label": "Banner text", "default": "#F4F0EE" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "light", "label": "Warm accent card, product on the right" },
            { "value": "dark", "label": "Obsidian card, image behind text" }
          ],
          "default": "light"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For someone you love" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> for the italic accent.", "default": "Gift love they’ll <em>remember.</em>" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Give a meaningful daily reminder that keeps your care close, through every soft cue and quiet reset." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Gift Breathelet" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift banners",
      "blocks": [
        { "type": "banner", "settings": { "style": "light" } },
        {
          "type": "banner",
          "settings": {
            "style": "dark",
            "eyebrow": "Eternal Love Pair",
            "heading": "Two Breathelets. <em>One connection.</em>",
            "text": "One shared reminder to breathe, reset, and stay present — together.",
            "button_label": "Buy the Pair · $59.99"
          }
        }
      ]
    }
  ]
}
{% endschema %}
