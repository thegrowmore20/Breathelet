{% render 'section-bg-number-vars' %}

{%- capture gift_style -%}
  --section-pt-max: 0px;
  --bn-panel: {{ section.settings.panel_background }};
  --bn-dark-background: {{ section.settings.dark_background }};
  --bn-dark-rgb: {{ section.settings.dark_text.rgb }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'gift', style: gift_style %}>
  <div class="section-body">
    <div class="banner">
      {%- for block in section.blocks -%}
        {%- assign is_light = false -%}
        {%- if block.settings.style == 'light' -%}
          {%- assign is_light = true -%}
        {%- endif -%}
        <div
          class="bn {% if is_light %}lt{% else %}dk{% endif %}"
          data-animation="block"
          data-animation-group="{{ section.id }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- if is_light -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'pimg',
                  widths: '352, 550, 832, 1200',
                  sizes: '(min-width: 992px) 30vw, 52vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  class: 'bg',
                  widths: '352, 550, 832, 1200',
                  sizes: '(min-width: 992px) 50vw, 100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {%- endif -%}
          {%- endif -%}
          <div class="bn-t">
            {%- if block.settings.eyebrow != blank -%}
              <div class="eyebrow">{{ block.settings.eyebrow | escape }}</div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a
                href="{{ block.settings.button_link }}"
                class="btn {% if is_light %}btn-dark{% else %}btn-light{% endif %}"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gift {
    --bn-mute: rgb(var(--color-foreground) / 65%);
  }

  .gift .eyebrow {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bn-mute);
    font-weight: 500;
  }

  .gift .banner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .gift .bn {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    min-height: min(440px, 58svh);
    background: var(--bn-dark-background);
    color: rgb(var(--bn-dark-rgb));
    display: flex;
    align-items: flex-end;
  }

  .gift .bn > img.bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6% 6% 30% 20%;
  }

  .gift .bn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(var(--bn-dark-background-rgb, 0 0 0) / 72%), transparent 65%);
    pointer-events: none;
  }

  .gift .bn-t {
    position: relative;
    z-index: 2;
    padding: 32px;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }

  .gift .bn-t h2 {
    font-family: var(--font-heading-family);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.05;
    font-size: clamp(34px, 3.6vw, 50px);
  }

  .gift .bn-t h2 em {
    font-style: italic;
    color: rgb(var(--bn-dark-rgb) / 66%);
  }

  .gift .bn-t p {
    color: rgb(var(--bn-dark-rgb) / 83%);
    font-size: 15px;
  }

  .gift .bn.dk .eyebrow {
    color: rgb(var(--bn-dark-rgb) / 80%);
  }

  .gift .bn.lt {
    background: var(--bn-panel);
    color: rgb(var(--color-foreground));
  }

  .gift .bn.lt::after {
    display: none;
  }

  .gift .bn.lt p {
    color: rgb(var(--color-foreground) / 75%);
  }

  .gift .bn.lt h2 em {
    color: var(--bn-mute);
  }

  .gift .bn.lt .pimg {
    position: absolute;
    right: -2%;
    top: 4%;
    width: 62%;
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 24px 24px rgb(0 0 0 / 25%));
  }

  .gift .bn.lt .bn-t {
    max-width: 56%;
  }

  .gift .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 26px;
    border-radius: 99px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .gift .btn-dark {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  .gift .btn-light {
    background: rgb(var(--bn-dark-rgb));
    color: var(--bn-dark-background);
  }

  @media (max-width: 991px) {
    .gift .banner {
      grid-template-columns: 1fr;
    }

    .gift .bn.lt .bn-t {
      max-width: none;
    }

    .gift .bn.lt .pimg {
      width: 52%;
      top: 2%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gift banners",
  "class": "section-gift-banners",
  "max_blocks": 2,
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4F4F2" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0B0B0B" },
    { "type": "color", "id": "panel_background", "label": "Light banner background", "default": "#ECECEA" },
    { "type": "color", "id": "dark_background", "label": "Dark banner background", "default": "#161616" },
    { "type": "color", "id": "dark_text", "label": "Dark banner text", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "light", "label": "Light, product on the right" },
            { "value": "dark", "label": "Dark, image behind text" }
          ],
          "default": "light"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For someone you love" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "info": "Wrap a word in <em> for the italic accent.", "default": "Gift love they’ll <em>remember.</em>" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Give a meaningful daily reminder that keeps your care close, through every soft cue and quiet reset." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Gift Breathelet" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift banners",
      "blocks": [
        { "type": "banner", "settings": { "style": "light" } },
        {
          "type": "banner",
          "settings": {
            "style": "dark",
            "eyebrow": "Eternal Love Pair",
            "heading": "Two Breathelets. <em>One connection.</em>",
            "text": "One shared reminder to breathe, reset, and stay present — together.",
            "button_label": "Buy the Pair · $59.99"
          }
        }
      ]
    }
  ]
}
{% endschema %}
