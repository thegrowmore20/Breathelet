{% render 'section-bg-number-vars' %}

{%- liquid
  assign has_intro_image = false
  if section.settings.intro_img_1 != blank or section.settings.intro_img_url_1 != blank or section.settings.intro_img_2 != blank or section.settings.intro_img_url_2 != blank
    assign has_intro_image = true
  endif

  assign heading_tag = section.settings.heading_html_tag | default: 'h2'
  assign accent_color = section.settings.accent_color | default: '#a57c72'
  assign accent_rgb = '165 124 114'
  if section.settings.accent_color != blank
    assign accent_rgb = section.settings.accent_color.rgb
  endif
  assign card_bg = section.settings.card_background | default: '#0d0b0a'
-%}

{%- capture usps_style -%}
  --usps-bg: {{ section.settings.bg_color | default: '#000000' }};
  --usps-accent: {{ accent_color }};
  --usps-accent-rgb: {{ accent_rgb }};
  --usps-card: {{ card_bg }};
  --usps-link: {{ section.settings.link_color | default: accent_color }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'usps-section', style: usps_style %}>
  <div class="section-body">
    <div class="usps-wrap{% if section.settings.vertical_layout %} usps-wrap--vertical{% endif %}">
      {%- if has_intro_image -%}
        <div
          class="usps-intro{% if section.settings.show_divider %} usps-intro--divider{% endif %}"
          data-animation="block"
          data-animation-group="{{ section.id }}-intro"
        >
          <div class="usps-intro__header">
            {%- if section.settings.eyebrow != blank -%}
              <div class="subheading usps-intro__eyebrow">{{ section.settings.eyebrow | escape }}</div>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <{{ heading_tag }} class="heading h0 usps-intro__heading">{{ section.settings.heading }}</{{ heading_tag }}>
            {%- endif -%}
            {%- if section.settings.text_1 != blank -%}
              <p class="usps-intro__sub">{{ section.settings.text_1 | escape }}</p>
            {%- endif -%}
          </div>

          <div class="usps-badges">
            {%- if section.settings.intro_img_1 != blank -%}
              {%- assign alt_intro_img_1 = section.settings.intro_img_1.alt | default: 'Lifetime Warranty' -%}
              <div class="usps-badge">
                <div class="usps-badge__media">
                  {{
                    section.settings.intro_img_1
                    | image_url: width: 352
                    | image_tag:
                      widths: '352, 550',
                      sizes: '(max-width: 575px) 130px, 190px',
                      width: 190,
                      height: 190,
                      alt: alt_intro_img_1,
                      loading: 'lazy'
                  }}
                </div>
                {%- if section.settings.intro_text_1 != blank -%}
                  <h3 class="usps-badge__label">{{ section.settings.intro_text_1 | escape }}</h3>
                {%- endif -%}
              </div>
            {%- elsif section.settings.intro_img_url_1 != blank -%}
              <div class="usps-badge">
                <div class="usps-badge__media">
                  <img
                    src="{{ section.settings.intro_img_url_1 }}"
                    alt="{{ section.settings.intro_text_1 | default: 'Lifetime Warranty' | escape }}"
                    loading="lazy"
                    width="190"
                    height="190"
                  >
                </div>
                {%- if section.settings.intro_text_1 != blank -%}
                  <h3 class="usps-badge__label">{{ section.settings.intro_text_1 | escape }}</h3>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.intro_img_1 != blank or section.settings.intro_img_url_1 != blank -%}
              {%- if section.settings.intro_img_2 != blank or section.settings.intro_img_url_2 != blank -%}
                <span class="usps-badges__sep" aria-hidden="true"></span>
              {%- endif -%}
            {%- endif -%}

            {%- if section.settings.intro_img_2 != blank -%}
              {%- assign alt_intro_img_2 = section.settings.intro_img_2.alt | default: '15 Days Moneyback Guarantee' -%}
              <div class="usps-badge">
                <div class="usps-badge__media">
                  {{
                    section.settings.intro_img_2
                    | image_url: width: 352
                    | image_tag:
                      widths: '352, 550',
                      sizes: '(max-width: 575px) 130px, 190px',
                      width: 190,
                      height: 190,
                      alt: alt_intro_img_2,
                      loading: 'lazy'
                  }}
                </div>
                {%- if section.settings.intro_text_2 != blank -%}
                  <h3 class="usps-badge__label">{{ section.settings.intro_text_2 | escape }}</h3>
                {%- endif -%}
              </div>
            {%- elsif section.settings.intro_img_url_2 != blank -%}
              <div class="usps-badge">
                <div class="usps-badge__media">
                  <img
                    src="{{ section.settings.intro_img_url_2 }}"
                    alt="{{ section.settings.intro_text_2 | default: '15 Days Moneyback Guarantee' | escape }}"
                    loading="lazy"
                    width="190"
                    height="190"
                  >
                </div>
                {%- if section.settings.intro_text_2 != blank -%}
                  <h3 class="usps-badge__label">{{ section.settings.intro_text_2 | escape }}</h3>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="usps-grid">
        {%- for block in section.blocks -%}
          <article
            class="usps-card"
            data-animation="block"
            data-animation-group="{{ section.id }}-cards"
            {{ block.shopify_attributes }}
          >
            <span class="usps-card__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>

            {%- if block.settings.icon_html != blank -%}
              <div class="usps-card__icon" aria-hidden="true">
                {{ block.settings.icon_html }}
              </div>
            {%- elsif block.settings.icon_image != blank -%}
              {%- assign alt_image = block.settings.icon_image.alt | default: block.settings.title -%}
              <div class="usps-card__icon">
                {{
                  block.settings.icon_image
                  | image_url: width: 352
                  | image_tag:
                    widths: '352',
                    sizes: '36px',
                    width: 36,
                    height: 36,
                    alt: alt_image,
                    loading: 'lazy'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="usps-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="usps-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}

            <span class="usps-card__rule" aria-hidden="true"></span>

            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="usps-card__link">
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .usps-section {
    --usps-line: rgb(var(--color-foreground) / 10%);
    --usps-muted: rgb(var(--color-foreground) / 68%);
    --usps-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .usps-wrap {
    display: flex;
    gap: clamp(28px, 4vw, 56px);
    width: 100%;
    background-color: var(--usps-bg);
    color: rgb(var(--color-foreground));
  }

  .usps-wrap--vertical {
    flex-direction: column;
    gap: clamp(20px, 2.5vw, 28px);
  }

  .usps-intro {
    position: relative;
    flex: 0 0 38%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(36px, 4.5vw, 58px) clamp(24px, 4vw, 52px);
    border-radius: 28px;
    border: 1px solid rgb(var(--usps-accent-rgb) / 26%);
    background:
      radial-gradient(62% 58% at 50% 0%, rgb(var(--usps-accent-rgb) / 15%) 0%, transparent 72%),
      linear-gradient(180deg, rgb(var(--usps-accent-rgb) / 6%) 0%, var(--usps-card) 58%, var(--usps-bg) 100%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
    overflow: hidden;
    isolation: isolate;
  }

  .usps-wrap--vertical .usps-intro {
    flex: auto;
    width: 100%;
  }

  .usps-intro__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 680px;
  }

  .usps-intro__eyebrow {
    color: var(--usps-accent);
  }

  .usps-intro__heading {
    margin: 0;
    color: rgb(var(--color-foreground));
  }

  .usps-intro__heading em {
    color: var(--usps-accent);
    font-style: italic;
    padding-right: 0.08em;
  }

  .usps-intro__sub {
    margin: 4px 0 0;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.6;
    color: var(--usps-muted);
    max-width: 48ch;
  }

  .usps-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 5vw, 72px);
    margin-top: clamp(28px, 3.2vw, 42px);
    width: 100%;
  }

  .usps-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transition: transform 320ms var(--usps-ease);
  }

  .usps-badge:hover {
    transform: translateY(-4px);
  }

  .usps-badge__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(132px, 16vw, 186px);
    height: clamp(132px, 16vw, 186px);
    border-radius: 50%;
    padding: 14px;
    background: radial-gradient(circle, rgb(var(--usps-accent-rgb) / 10%) 0%, transparent 72%);
  }

  .usps-badge__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .usps-badge__label {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground) / 88%);
  }

  .usps-badges__sep {
    width: 1px;
    height: clamp(72px, 9vw, 110px);
    background: linear-gradient(180deg, transparent, rgb(var(--usps-accent-rgb) / 42%), transparent);
    flex-shrink: 0;
  }

  .usps-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
  }

  .usps-wrap--vertical .usps-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .usps-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(26px, 2.6vw, 36px) clamp(18px, 2vw, 26px);
    border-radius: 22px;
    background: var(--usps-card);
    border: 1px solid var(--usps-line);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 5%);
    transition: transform 300ms var(--usps-ease);
    overflow: hidden;
  }

  .usps-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid rgb(var(--usps-accent-rgb) / 45%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--usps-ease);
  }

  .usps-card:hover {
    transform: translateY(-4px);
  }

  .usps-card:hover::after {
    opacity: 1;
  }

  .usps-card__num {
    position: absolute;
    top: 16px;
    left: 18px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--usps-accent);
    opacity: 0.78;
  }

  .usps-card__icon {
    width: 60px;
    height: 60px;
    margin-top: 8px;
    margin-bottom: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgb(var(--usps-accent-rgb) / 10%);
    border: 1px solid rgb(var(--usps-accent-rgb) / 28%);
    color: rgb(var(--color-foreground));
  }

  .usps-card__icon svg,
  .usps-card__icon img {
    width: 30px;
    height: 30px;
    object-fit: contain;
    display: block;
  }

  .usps-card__title {
    margin: 0 0 8px;
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.35;
    color: rgb(var(--color-foreground));
  }

  .usps-card__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--usps-muted);
    max-width: 24ch;
  }

  .usps-card__rule {
    display: block;
    width: 24px;
    height: 1px;
    margin-top: 18px;
    background: rgb(var(--usps-accent-rgb) / 55%);
    transform-origin: center;
    transition: transform 300ms var(--usps-ease);
  }

  .usps-card:hover .usps-card__rule {
    transform: scaleX(1.9);
  }

  .usps-card__link {
    margin-top: 14px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--usps-link);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .usps-card__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 991px) {
    .usps-wrap {
      flex-direction: column;
      gap: 24px;
    }

    .usps-wrap--vertical .usps-grid,
    .usps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 575px) {
    .usps-intro {
      border-radius: 22px;
      padding: 28px 18px;
    }

    .usps-badges {
      gap: 18px;
      margin-top: 24px;
    }

    .usps-badge__media {
      width: 118px;
      height: 118px;
      padding: 8px;
    }

    .usps-badges__sep {
      height: 64px;
    }

    .usps-grid,
    .usps-wrap--vertical .usps-grid {
      gap: 10px;
    }

    .usps-card {
      border-radius: 18px;
      padding: 22px 14px;
    }

    .usps-card__num {
      top: 12px;
      left: 12px;
      font-size: 10px;
    }

    .usps-card__icon {
      width: 48px;
      height: 48px;
      margin-bottom: 14px;
    }

    .usps-card__icon svg,
    .usps-card__icon img {
      width: 24px;
      height: 24px;
    }

    .usps-card__title {
      font-size: 11.5px;
      letter-spacing: 0.09em;
    }

    .usps-card__text {
      font-size: 12.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .usps-badge,
    .usps-card,
    .usps-card::after,
    .usps-card__rule {
      transition: none;
    }

    .usps-badge:hover,
    .usps-card:hover {
      transform: none;
    }

    .usps-card:hover .usps-card__rule {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "General USPs",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.all.full_width.label",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Container Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#a57c72"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Surface Color",
      "default": "#0d0b0a"
    },
    {
      "id": "vertical_layout",
      "type": "checkbox",
      "label": "Vertical Layout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show Vertical Divider",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR PROMISE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy with <em>Confidence</em>"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph",
      "default": "Risk Free Shopping & Satisfaction Guaranteed"
    },
    {
      "type": "image_picker",
      "id": "intro_img_1",
      "label": "First Intro Image"
    },
    {
      "type": "text",
      "id": "intro_text_1",
      "label": "First Image Text",
      "default": "LIFETIME WARRANTY"
    },
    {
      "type": "image_picker",
      "id": "intro_img_2",
      "label": "Second Intro Image"
    },
    {
      "type": "text",
      "id": "intro_text_2",
      "label": "Second Image Text",
      "default": "15 DAYS GUARANTEE"
    },
    {
      "type": "text",
      "id": "intro_img_url_1",
      "label": "First Intro Image URL (overridden by picker above)"
    },
    {
      "type": "text",
      "id": "intro_img_url_2",
      "label": "Second Intro Image URL (overridden by picker above)"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Service Link Color",
      "default": "#a57c72"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.colors"
    },
    {
      "type": "color",
      "label": "t:sections.all.background_color.label",
      "id": "background_color"
    },
    {
      "type": "color",
      "label": "t:sections.all.text_color.label",
      "id": "text_color"
    },
    {
      "type": "color",
      "label": "t:sections.all.heading_color.label",
      "id": "heading_color"
    },
    {
      "type": "header",
      "content": "t:sections.all.headers.seo"
    },
    {
      "type": "select",
      "id": "heading_html_tag",
      "label": "t:sections.all.heading_html_tag.label",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" },
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" }
      ],
      "default": "h2",
      "info": "t:sections.all.heading_html_tag.info"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Item",
      "limit": 6,
      "settings": [
        {
          "type": "html",
          "id": "icon_html",
          "label": "Icon HTML (SVG)"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
