{% render 'section-bg-number-vars' %}

{%- liquid
  assign first_ratio = '1 / 1'
  if section.settings.image_aspect_ratio == 'auto'
    for block in section.blocks
      if block.settings.image != blank
        assign first_ratio = block.settings.image.aspect_ratio
        break
      endif
    endfor
  else
    assign first_ratio = section.settings.image_aspect_ratio | default: '1 / 1'
  endif
-%}

{%- capture ritual_style -%}
  --primary: {{ section.settings.primary_color }};
  --accent: {{ section.settings.accent_color }};
  --accent-rgb: {{ section.settings.accent_color.rgb }};
  --rit-surface: {{ section.settings.media_background }};
  --rit-ratio: {{ first_ratio }};
{%- endcapture -%}

<section {% render 'section-attrs', class: 'ritual', style: ritual_style %}>
  <div class="section-body">
    <ritual-accordion class="rit grid items-center">
      <div class="rit-l flex flex-col" data-animation="block" data-animation-group="{{ section.id }}-acc">
        <div class="rit-acc w-full">
          {%- for block in section.blocks -%}
            {%- assign is_open = forloop.first -%}
            <div
              class="ri{% if is_open %} open{% endif %}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="ri-h w-full flex justify-between items-center text-left"
                aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
                aria-controls="RitualPanel-{{ section.id }}-{{ forloop.index }}"
              >
                <span>{{ block.settings.title | escape }}</span>
                <i class="relative flex-shrink-0" aria-hidden="true"></i>
              </button>
              <div class="ri-p" id="RitualPanel-{{ section.id }}-{{ forloop.index }}">
                <div>
                  <div class="ri-b">
                    {%- if block.settings.content != blank -%}
                      <div class="ri-content">{{ block.settings.content }}</div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div
        class="rit-m{% if section.settings.image_aspect_ratio == 'auto' %} rit-m--auto{% endif %}"
        data-animation="block"
        data-animation-group="{{ section.id }}-media"
      >
        {%- for block in section.blocks -%}
          {%- assign img_class = 'rit-img' -%}
          {%- if forloop.first -%}
            {%- assign img_class = 'rit-img on' -%}
          {%- endif -%}
          <div
            class="{{ img_class }}"
            data-media-index="{{ forloop.index0 }}"
            {% if block.settings.image != blank %}data-aspect-ratio="{{ block.settings.image.aspect_ratio }}"{% endif %}
          >
            {%- if block.settings.image != blank -%}
              {%- assign ritual_alt = block.settings.image.alt | default: block.settings.title | default: 'Breathelet ritual' -%}
              {{
                block.settings.image
                | image_url: width: 1500
                | image_tag:
                  widths: '352, 550, 832, 1200, 1500',
                  sizes: '(min-width: 992px) 52vw, 100vw',
                  loading: 'lazy',
                  decoding: 'async',
                  alt: ritual_alt
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </ritual-accordion>
  </div>
</section>

{% javascript %}
  if (!customElements.get('ritual-accordion')) {
    class RitualAccordion extends HTMLElement {
      connectedCallback() {
        this._controller = new AbortController();
        const { signal } = this._controller;

        this.addEventListener(
          'click',
          (event) => {
            const trigger = event.target.closest('.ri-h');
            if (!trigger || !this.contains(trigger)) return;

            const item = trigger.closest('.ri');
            if (!item || item.classList.contains('open')) return;

            for (const openItem of this.querySelectorAll('.ri.open')) {
              openItem.classList.remove('open');
              const btn = openItem.querySelector('.ri-h');
              if (btn) btn.setAttribute('aria-expanded', 'false');
            }

            item.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');

            const idx = item.dataset.index;
            const mediaBox = this.querySelector('.rit-m');
            for (const slide of this.querySelectorAll('.rit-img')) {
              const isMatch = slide.dataset.mediaIndex === idx;
              slide.classList.toggle('on', isMatch);
              if (isMatch && mediaBox && mediaBox.classList.contains('rit-m--auto') && slide.dataset.aspectRatio) {
                mediaBox.style.setProperty('--rit-ratio', slide.dataset.aspectRatio);
              }
            }
          },
          { signal }
        );
      }

      disconnectedCallback() {
        if (this._controller) this._controller.abort();
      }
    }

    customElements.define('ritual-accordion', RitualAccordion);
  }
{% endjavascript %}

{% stylesheet %}
  .ritual {
    --rit-line: rgb(var(--color-foreground) / 10%);
    --rit-tx2: rgb(var(--color-foreground) / 68%);
    --rit-ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    content-visibility: auto;
    contain-intrinsic-size: auto 640px;
  }

  .rit {
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(40px, 6vw, 110px);
  }

  .rit-l {
    align-items: stretch;
  }

  .rit-acc {
    border-top: 1px solid var(--rit-line);
    align-self: start;
  }

  .ri {
    border-bottom: 1px solid var(--rit-line);
  }

  .ri-h {
    min-height: 44px;
    gap: 20px;
    padding: 30px 0;
    font-family: var(--font-heading-family);
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 400;
    line-height: 1.22;
    letter-spacing: -0.01em;
    color: var(--rit-tx2);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .ri-h:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .ri.open .ri-h,
  .ri-h:hover {
    color: rgb(var(--color-foreground));
  }

  .ri-h i {
    width: 14px;
    height: 14px;
  }

  .ri-h i::before,
  .ri-h i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transition: transform 280ms var(--rit-ease);
  }

  .ri-h i::after {
    transform: rotate(90deg);
  }

  .ri.open .ri-h i::after {
    transform: rotate(0deg);
  }

  .ri-p {
    display: grid;
    grid-template-rows: 0fr;
    contain: layout paint;
    transition: grid-template-rows 280ms var(--rit-ease);
  }

  .ri-p > div {
    overflow: hidden;
  }

  .ri.open .ri-p {
    grid-template-rows: 1fr;
  }

  .ri-b {
    padding: 0 0 32px;
    display: grid;
    gap: 18px;
    color: var(--rit-tx2);
    font-size: 16px;
    line-height: 1.6;
    max-width: 560px;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 280ms var(--rit-ease), transform 280ms var(--rit-ease);
  }

  .ri.open .ri-b {
    opacity: 1;
    transform: none;
  }

  .ri-content p {
    margin: 0;
  }

  .ri-content p + p,
  .ri-content p + ul {
    margin-top: 14px;
  }

  .ri-content ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .ri-content li {
    display: flex;
    gap: 12px;
    align-items: center;
    color: rgb(var(--color-foreground));
  }

  .ri-content li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .ri-content strong,
  .ri-content b {
    color: rgb(var(--color-foreground));
    font-weight: 600;
  }

  .rit-m {
    position: relative;
    aspect-ratio: var(--rit-ratio, 1 / 1);
    max-height: 78svh;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: var(--rit-surface);
    border: 1px solid var(--rit-line);
  }

  .rit-m--auto {
    max-height: none;
  }

  .rit-img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 600ms var(--rit-ease), transform 900ms var(--rit-ease);
  }

  .rit-img.on {
    opacity: 1;
    transform: none;
  }

  .rit-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 991px) {
    .rit {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .rit-m {
      order: -1;
      max-height: none;
    }
  }

  @media (max-width: 575px) {
    .ri-h {
      padding: 22px 0;
    }

    .ri-b {
      padding-bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ri-h i::before,
    .ri-h i::after,
    .ri-p,
    .ri-b,
    .rit-img {
      transition: none;
    }

    .rit-img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ritual accordion",
  "class": "section-ritual-accordion",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "auto", "label": "Auto (adapt to image)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Landscape wide (16:9)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "2 / 3", "label": "Portrait tall (2:3)" }
      ],
      "default": "1 / 1"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F4F0EE" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#000000" },
    { "type": "color", "id": "accent_color", "label": "Secondary (accent)", "default": "#A57C72" },
    { "type": "color", "id": "media_background", "label": "Media fallback surface", "default": "#0E0D0C" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "BREATHE" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>This archaic Sanskrit symbol gracefully inspires us to embrace our natural responses. It represents life’s first and final acts, portraying the elegant symmetry of our existence.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ritual accordion",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "You can't control your stress without controlling your breath",
            "content": "<p>Breathelet sends a gentle random vibration every 60–150 minutes, a soft reminder to:</p><ul><li>Be present in the moment</li><li>Take a deep breath</li><li>Correct your posture</li><li>Hydrate</li><li>Build Mindful Habits</li></ul>"
          }
        },
        {
