<div class="trim-margins">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when '@app' %}
        {% render block %}
      {% when 'heading' %}
        {% comment %} Heading {% endcomment %}
        <div class="{{ block.settings.heading_size }} my-6" {{ block.shopify_attributes }}>
          {{ block.settings.heading }}
        </div>
      {% when 'text' %}
        <div class="prose  my-6" {{ block.shopify_attributes }}>
          {{ block.settings.content }}
        </div>
      {% when 'free_shipping_bar' %}
        {% comment %} Free shipping bar {% endcomment %}
        {% render 'free-shipping-indicator', class: 'my-6', attrs: block.shopify_attributes %}

      {% when 'totals' %}
        {% comment %} Totals {% endcomment %}
        <div class="cart-totals my-6 md:my-8" {{ block.shopify_attributes }}>
          {%- if block.settings.show_order_weight -%}
            <div class="flex justify-between text-foreground/75 mb-4">
              <div>{{ 'sections.cart.weight' | t }}</div>
              <div>{{ cart.total_weight | weight_with_unit }}</div>
            </div>
          {%- endif -%}

          {%- liquid
            assign compare_at_total = 0
            assign total_compare_at_savings = 0
            assign c_savings_percent = 0
            assign regular_price_total = 0
            assign discount_total = cart.total_discount
            for item in cart.items
              assign item_total_compare_price = 0
              assign quantity = item.quantity
              assign regular_price = item.variant.price
              assign compare_price = item.variant.compare_at_price
              assign item_total_regular_price = regular_price | times: quantity
              if compare_price and compare_price > regular_price
                assign item_total_compare_price = compare_price | times: quantity
              else
                assign item_total_compare_price = regular_price | times: quantity
              endif
              assign compare_at_total = compare_at_total | plus: item_total_compare_price
              assign regular_price_total = regular_price_total | plus: item_total_regular_price
              if compare_price and compare_price > regular_price
                assign single_item_save = compare_price | minus: regular_price
                assign line_item_save = single_item_save | times: quantity
                assign total_compare_at_savings = total_compare_at_savings | plus: line_item_save
              endif
              assign item_level_discount_percentage = 0
              if item.line_level_discount_allocations.size > 0
                for discount in item.line_level_discount_allocations
                  assign item_level_discount_percentage = item_level_discount_percentage | plus: discount.discount_application.value | round
                endfor
              endif
            endfor
            if compare_at_total > 0 and total_compare_at_savings > 0
              assign c_savings_percent = total_compare_at_savings | times: 100.0 | divided_by: compare_at_total | round
            endif
            assign cart_level_discount_percentage = 0
            for discount in cart.cart_level_discount_applications
              assign cart_level_discount_percentage = cart_level_discount_percentage | plus: discount.value | round
            endfor
            assign grand_saving = c_savings_percent | plus: item_level_discount_percentage | plus: cart_level_discount_percentage
            assign total_line_price = compare_at_total | minus: regular_price_total
            assign total_saved_amount = total_line_price | plus: discount_total
          -%}

          <div class="flex justify-between">
            <div>Total Price</div>
            <div class="cart-subtotal">{{ compare_at_total | money }}</div>
          </div>

          {%- if total_saved_amount > 0 -%}
            <div class="flex justify-between font-bold mt-2" style="color: #34A853;">
              <div class="flex items-center gap-1">
                You Save
                <span class="flex items-center gap-1">
                  <span class="icon-xs" style="--icon-stroke-width: 1.75">{% render 'icon-discount' %}</span>
                  {{ grand_saving | append: '%' }}
                </span>
              </div>
              <div>-{{ total_saved_amount | money }}</div>
            </div>
          {%- endif -%}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <div class="mt-2">
              <ul class="list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="flex items-center">
                    <div class="icon-xs md:icon-sm mr-3 shrink-0" style="--icon-stroke-width: 1.75">
                      {% render 'icon-discount' %}
                    </div>
                    <div class="font-bold pr-3">{{ discount.title | replace: 'Discount', 'You Save' }}</div>
                    <div class="ml-auto whitespace-nowrap">-{{ discount.total_allocated_amount | money }}</div>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <hr class="my-4">

          <div class="flex items-center justify-between heading font-bold text-lg md:text-h5">
            <div>Subtotal</div>
            <div class="cart-total">{{ cart.total_price | money_with_currency }}</div>
          </div>

          {% if block.settings.show_shipping_taxes_message %}
            <div class="text-sm text-foreground/75 mt-4">
              {% render 'cart-policy-text' %}
            </div>
          {% endif %}
        </div>

      {% when 'shipping_estimator' %}
        {% comment %} Shipping estimator {% endcomment %}
        <modal-trigger
          target=".shipping-estimator-modal"
          class="block my-4 md:my-6 no-js:hidden max-md:text-sm"
          {{ block.shopify_attributes }}
        >
          <button class="flex items-center gap-4 hover:underline underline-offset-4">
            <div class="icon-xs md:icon-sm">
              {%- render 'icon-truck' -%}
            </div>
            <span>{{ 'sections.cart.estimate_shipping' | t }}</span>
          </button>
        </modal-trigger>

      {% when 'cart_note' %}
        {% comment %} Cart note {% endcomment %}
        <div class="my-4 md:my-6 max-md:text-sm" {{ block.shopify_attributes }}>
          {%- if cart.note == blank -%}
            <add-order-note target-input="#Cart-Note-Wrapper" class="no-js:hidden">
              <button class="flex items-center gap-4 hover:underline underline-offset-4">
                <div class="icon-xs md:icon-sm">
                  {%- render 'icon-pencil' -%}
                </div>
                {{ 'sections.cart.add_note' | t }}
              </button>
            </add-order-note>
          {%- endif -%}

          <div
            id="Cart-Note-Wrapper"
            class="form-floating mt-6 no-js:!block"
            {%- if cart.note == blank -%}
              style="display: none"
            {%- endif -%}
          >
            <textarea
              class="input"
              name="note"
              id="Cart-Note"
              placeholder="{{ 'sections.cart.note' | t }}"
              rows="4"
            >{{ cart.note }}</textarea>
            <label for="Cart-Note">{{ 'sections.cart.note' | t }}</label>
          </div>
        </div>

      {% when 'checkout_button' %}
        {% comment %} Checkout button {% endcomment %}
        <div class="my-8" {{ block.shopify_attributes }}>
          <noscript>
            <button class="button button-secondary w-full mb-2">
              {{ 'sections.cart.update_quantities' | t }}
            </button>
          </noscript>

          <button
            class="button w-full py-5 {{ block.settings.button_style }}"
            style="
              {% render 'button-vars',
              background: block.settings.button_background_color,
              text: block.settings.button_text_color %}
            "
            name="checkout"
            type="submit"
          >
            {{ 'sections.cart.checkout' | t }}
          </button>

          {% comment %} Additional checkout buttons {% endcomment %}
          {% if additional_checkout_buttons and block.settings.show_dynamic_checkout_buttons %}
            <div
              class="additional-checkout-buttons additional-checkout-buttons--vertical"
              id="additional-checkout-buttons"
            >
              {{ content_for_additional_checkout_buttons }}
            </div>
          {% endif %}
        </div>
    {% endcase %}
  {% endfor %}
</div>

<div id="Cart-Errors" role="alert" class="message message-danger text-danger mt-6"></div>
