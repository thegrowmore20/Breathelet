{% doc %}
  @prompt
    I need a section that has an image background with an overlay, I need to have 4 icons  with title and text under each icon. The desktop view has to show the icons horizontally and on mobile one under each other., I need to upload my own icons, I need to have separate images for desktop and mobile
{% enddoc %}

{%- assign ai_gen_id = block.id | replace: '_', '' | downcase -%}

{%- liquid
  if block.settings.loading_eager
    assign loading_val = 'eager'
    assign fetchpriority_val = 'high'
  else
    assign loading_val = 'lazy'
    assign fetchpriority_val = 'auto'
  endif
-%}

{% style %}
  .ai-icon-features-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .ai-icon-features-container-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  /* ── Background image (grayscale) ── */
  .ai-icon-features-background-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 0;
    filter: grayscale(100%) contrast(1.05);
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-icon-features-background-{{ ai_gen_id }} picture,
  .ai-icon-features-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Gradient overlay (fades from sides) ── */
  .ai-icon-features-overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      {{ block.settings.overlay_color }} 0%,
      rgba(17, 17, 17, 0.55) 28%,
      rgba(17, 17, 17, 0.2) 50%,
      rgba(17, 17, 17, 0.55) 72%,
      {{ block.settings.overlay_color }} 100%
    );
    pointer-events: none;
  }

  /* ── Grid ── */
  .ai-icon-features-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-icon-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    max-width: 1600px;
    margin: 0 auto;
  }

  /* ── Item ── */
  .ai-icon-feature-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: {{ block.settings.padding_vertical }}px 20px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    transition: background-color 0.3s ease;
  }

  .ai-icon-feature-item-{{ ai_gen_id }}:last-child {
    border-right: none;
  }

  .ai-icon-feature-item-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 0.025);
  }

  /* ── Counter number ── */
  .ai-icon-feature-counter-{{ ai_gen_id }} {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: #7c7874;
    margin-bottom: 16px;
    line-height: 1;
  }

  /* ── Icon (uploaded image, no circle) ── */
  .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
    width: 28px;
    height: 28px;
    margin-bottom: 16px;
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-feature-item-{{ ai_gen_id }}:hover .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} {
    transform: translateY(-2px);
  }

  .ai-icon-feature-icon-wrapper-{{ ai_gen_id }} img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    display: block;
    filter: brightness(0) invert(1);
  }

  /* ── Title ── */
  .ai-icon-feature-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.01em;
    color: {{ block.settings.title_color }};
    margin: 0 0 14px;
  }

  /* ── Dash ── */
  .ai-icon-feature-dash-{{ ai_gen_id }} {
    display: block;
    width: 20px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  .ai-icon-feature-item-{{ ai_gen_id }}:hover .ai-icon-feature-dash-{{ ai_gen_id }} {
    width: 32px;
    background-color: rgba(255, 255, 255, 0.55);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .ai-icon-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
    .ai-icon-feature-item-{{ ai_gen_id }} {
      padding: 36px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .ai-icon-feature-item-{{ ai_gen_id }}:nth-child(3n) {
      border-right: none;
    }
    .ai-icon-feature-item-{{ ai_gen_id }}:nth-child(n+4) {
      border-bottom: none;
    }
  }

  @media (max-width: 600px) {
    .ai-icon-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
    .ai-icon-feature-item-{{ ai_gen_id }} {
      padding: 30px 14px;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .ai-icon-feature-item-{{ ai_gen_id }}:nth-child(3n) {
      border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
    .ai-icon-feature-item-{{ ai_gen_id }}:nth-child(2n) {
      border-right: none;
    }
    .ai-icon-feature-item-{{ ai_gen_id }}:nth-child(n+4) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .ai-icon-feature-item-{{ ai_gen_id }}:nth-child(n+5) {
      border-bottom: none;
    }
  }
{% endstyle %}

<div class="ai-icon-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-features-container-{{ ai_gen_id }}">

    {%- if block.settings.background_image_desktop or block.settings.background_image_mobile -%}
      <div class="ai-icon-features-background-{{ ai_gen_id }}" aria-hidden="true">
        {%- assign mobile_bg = block.settings.background_image_mobile | default: block.settings.background_image_desktop -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_bg | image_url: width: 375 }} 375w,
              {{ mobile_bg | image_url: width: 750 }} 750w,
              {{ mobile_bg | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
          >
          {%- if block.settings.background_image_desktop -%}
            {%- assign bg_alt = block.settings.background_image_desktop.alt | default: 'background' -%}
            {{-
              block.settings.background_image_desktop
              | image_url: width: 2000
              | image_tag:
                widths: '1100, 1500, 2000',
                sizes: '100vw',
                loading: loading_val,
                fetchpriority: fetchpriority_val,
                alt: bg_alt
            -}}
          {%- else -%}
            {%- assign bg_alt = block.settings.background_image_mobile.alt | default: 'background' -%}
            {{-
              block.settings.background_image_mobile
              | image_url: width: 1000
              | image_tag:
                widths: '375, 750, 1000',
                sizes: '100vw',
                loading: loading_val,
                fetchpriority: fetchpriority_val,
                alt: bg_alt
            -}}
          {%- endif -%}
        </picture>
      </div>
    {%- endif -%}

    <div class="ai-icon-features-overlay-{{ ai_gen_id }}" aria-hidden="true"></div>

    <div class="ai-icon-features-content-{{ ai_gen_id }}">
      <div class="ai-icon-features-grid-{{ ai_gen_id }}">
        {%- for i in (1..6) -%}
          {%- liquid
            assign title_key = 'feature_' | append: i | append: '_title'
            assign icon_key  = 'feature_' | append: i | append: '_icon'
            assign title = block.settings[title_key]
            assign icon  = block.settings[icon_key]
            if i < 10
              assign counter_num = '0' | append: i
            else
              assign counter_num = i
            endif
          -%}

          <div class="ai-icon-feature-item-{{ ai_gen_id }}">
            <span class="ai-icon-feature-counter-{{ ai_gen_id }}" aria-hidden="true">{{ counter_num }}</span>

            <div class="ai-icon-feature-icon-wrapper-{{ ai_gen_id }}" aria-hidden="true">
              {%- if icon != blank -%}
                {{ icon | image_url: width: 56 | image_tag: width: 28, height: 28, alt: '' }}
              {%- endif -%}
            </div>

            {%- if title != blank -%}
              <h3 class="ai-icon-feature-title-{{ ai_gen_id }}">{{ title }}</h3>
            {%- endif -%}

            <span class="ai-icon-feature-dash-{{ ai_gen_id }}" aria-hidden="true"></span>
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
