{
  "permissions": {
    "allow": [
      "Bash(shopify theme check *)",
      "Bash(shopify theme dev *)",
      "Bash(shopify theme list *)",
      "Bash(shopify theme push --theme 190095261933 --only *)",
      "Bash(shopify theme push --allow-live *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(npx lighthouse *)",
      "Bash(npx --yes lighthouse *)",
      "Bash(node .claude/hooks/*)",
      "Bash(node .claude/scripts/push-changed.mjs)",
      "Bash(node .claude/scripts/push-changed.mjs *)"
    ],
    "ask": [
      "Bash(shopify theme pull *)",
      "Bash(npm install *)",
      "Bash(node .claude/scripts/push-changed.mjs *--push*)"
    ],
    "deny": [
      "Bash(shopify theme push)",
      "Bash(shopify theme push --live *)",
      "Bash(shopify theme publish *)",
      "Bash(shopify theme delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(shopify theme push)",
      "PowerShell(shopify theme push *)",
      "PowerShell(shopify theme publish *)",
      "PowerShell(shopify theme delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "Edit(/config/settings_data.json)",
      "Write(/config/settings_data.json)",
      "Read(/.env)",
      "Read(/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edit.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/theme-check.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
